<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <K2UI.Tabs.TabPage name="about" label="About" style="display: flex;">
        <ui:Label tabindex="-1" text="K2-D2. the droid astropilot." display-tooltip-when-elided="true" name="Title" class="k2-title" />
        <ui:VisualElement name="page" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0);">
            <ui:VisualElement name="top" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); flex-direction: row;">
                <ui:VisualElement name="logo" style="flex-grow: 0; background-color: rgba(0, 0, 0, 0); background-image: url(&apos;project://database/Assets/Images/k2d2_big_icon.png?fileID=2800000&amp;guid=8ef988e0f43beb149a76620d7ba3ed65&amp;type=3#k2d2_big_icon&apos;); width: 130px; height: 130px; margin-left: 5px; margin-right: 5px;" />
                <ui:VisualElement style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); padding-left: 4px;">
                    <ui:Label tabindex="-1" text="Version" display-tooltip-when-elided="true" name="version" />
                    <ui:Label tabindex="-1" text="Thanks to ....&#10;...&#10;...&#10;...&#10;...&#10;...&#10;...&#10;...&#10;...&#10;...&#10;...&#10;...&#10;..&#10;" display-tooltip-when-elided="true" name="thanks" style="white-space: normal;" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="buttons_bar" class="separator k2-button-row" style="padding-top: 6px;">
                <ui:Button text="Reset All Settings" name="reset_all" class="k2-button" tooltip="Put every K2D2 setting back to its default" />
                <K2UI.ToggleButton name="debug" label="Debug Mode" class="big" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="settings" style="display: none;" />
    </K2UI.Tabs.TabPage>
</ui:UXML>
