<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <K2UI.Tabs.TabPage name="dock" label="Dock" style="display: flex;">
        <ui:VisualElement name="page" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); display: flex;">
            <ui:Label tabindex="-1" text="Docking Assistant" display-tooltip-when-elided="true" name="Title" class="k2-title" />
            <ui:VisualElement name="select_group" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); display: none;">
                <ui:DropdownField label="Control From" index="-1" choices="a,b,c" name="control_from_drop" />
                <ui:DropdownField label="Target" index="-1" choices="Duna,Mun,Kerbal,Too" name="target_drop" />
                <ui:DropdownField label="Dock" index="-1" choices="Duna,Mun,Kerbal,Too" name="dock_drop" />
            </ui:VisualElement>
            <ui:VisualElement name="context" class="advanced-info-table" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0);" />
            <ui:VisualElement name="button_bars" class="k2-button-column" style="margin-bottom: 10px;">
                <K2UI.K2Toggle label="Align Dock" name="align_dock" tooltip="Turn to face the targeted docking port" />
                <K2UI.ToggleButton label="Stop" name="run" class="big" />
                <ui:Button text="Main Thrust Brake" display-tooltip-when-elided="true" name="main_brake" class="k2-button" tooltip="Turn retrograde to the target and kill the relative speed with the main engines" />
                <ui:Button text="RCS Final Approach" display-tooltip-when-elided="true" name="rcs_final_approach" class="k2-button" tooltip="Fly the last metres to the docking port with RCS" />
                <ui:Button text="Cheat" display-tooltip-when-elided="true" name="cheat" class="k2-button" />
            </ui:VisualElement>
            <ui:VisualElement name="final_approach_group" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0);">
                <K2UI.InlineEnum name="final_mode" labels="Manual;Auto" />
                <ui:VisualElement name="manual_group">
                    <ui:Label text="// MANUAL MODE" class="k2-section-header" />
                    <ui:Label tabindex="-1" text="Kill speed with RCS" display-tooltip-when-elided="true" />
                    <ui:VisualElement name="rcs_kill_speed" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); flex-direction: row;">
                        <K2UI.ToggleButton label="Hor." name="horizontal_bt" style="flex-grow: 1;" />
                        <K2UI.ToggleButton label="Vert." name="vertical_bt" style="flex-grow: 1;" />
                        <K2UI.ToggleButton label="Depth" name="depth_bt" style="flex-grow: 1;" />
                        <K2UI.ToggleButton label="All" name="all_bt" style="flex-grow: 1;" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="auto_group">
                    <ui:Label text="// AUTOMATIC MODE" class="k2-section-header" />
                    <ui:Label tabindex="-1" text="Axis" display-tooltip-when-elided="true" />
                    <K2UI.K2Toggle label="Center Axis" name="center_axis" />
                    <K2UI.K2Slider name="center_power" tooltip="How hard RCS pushes to line up with the docking port" label="Centering Strength" format="N1" print-value="true" max="5" value="1" label-on-top="true" min-max-label="x" />
                    <ui:Label tabindex="-1" text="Forward" display-tooltip-when-elided="true" />
                    <K2UI.K2Toggle label="Auto Approach" name="auto_forward" />
                    <ui:VisualElement style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); flex-direction: row;">
                        <K2UI.K2Slider name="forward_speed" tooltip="Approach speed toward the docking port" label="Forward Speed (m/s)" format="N1" print-value="true" max="10" value="0" label-on-top="true" min-max-label="x" min="-10" style="flex-grow: 1; margin-bottom: 7px;" />
                        <ui:Button text="R." display-tooltip-when-elided="true" name="reset_fspeed" style="height: 40%; top: 27px;" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="status_progress_group" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); margin-top: 10px; margin-bottom: 12px;">
                <ui:VisualElement name="k2_status_row" class="k2-status-row">
                    <K2UI.K2Avatar name="k2_avatar" />
                    <ui:VisualElement name="k2_status_speech" class="k2-status-speech">
                        <K2UI.StatusLine tabindex="-1" text="Status Pilot" name="status_pilot" />
                        <K2UI.Console tabindex="-1" name="pilot_console" text="Console Pilot" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <K2UI.K2ProgressBar name="progress" set-label-to-value="false" value="70.27" max="100" label=" " postfix=" %" style="height: 25px;" />
            </ui:VisualElement>
            <ui:Foldout text="ADVANCED" value="false" name="advanced_foldout">
                <ui:VisualElement name="RCS">
                    <ui:Label text="// RCS" class="k2-section-header" />
                    <K2UI.K2Slider name="rcs_power" tooltip="How strongly the RCS corrections are applied" label="RCS Power" format="N1" print-value="true" label-on-top="true" min-max-label="x" />
                    <ui:Label tabindex="-1" text="K2D2 doesn't measure your vessel's RCS thrust yet (it depends on where the thrusters sit). Use this slider to match your vessel." class="k2-help" />
                </ui:VisualElement>
            </ui:Foldout>
        </ui:VisualElement>
        <ui:VisualElement name="settings" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); display: none;">
            <ui:Label tabindex="-1" text="Docking Settings" display-tooltip-when-elided="true" name="Title" class="k2-title" />
        </ui:VisualElement>
    </K2UI.Tabs.TabPage>
</ui:UXML>
