<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <K2UI.Tabs.TabPage name="attitude" label="Att." style="display: flex;">
        <ui:VisualElement name="page" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); display: flex;">
            <ui:Label tabindex="-1" text="Attitude Autopilot" display-tooltip-when-elided="true" name="Title" class="k2-title" />
            <ui:VisualElement name="elevation_group">
                <ui:Label text="// ELEVATION" class="k2-section-header" />
                <ui:VisualElement style="flex-direction: row; align-items: center;">
                    <ui:Label tabindex="-1" text="Elevation (°)" display-tooltip-when-elided="true" style="flex-grow: 1;" />
                    <ui:RepeatButton name="elevation_n_rb" class="k2-button k2-button--square" tooltip="Lower the nose 1°" text="-" />
                    <ui:FloatField value="42" name="elevation_field" />
                    <ui:RepeatButton name="elevation_p_rb" class="k2-button k2-button--square" tooltip="Raise the nose 1°" text="+" />
                </ui:VisualElement>
                <K2UI.K2Slider name="elevation_slider" />
            </ui:VisualElement>
            <ui:VisualElement name="heading_group">
                <ui:Label text="// HEADING" class="k2-section-header" />
                <ui:VisualElement name="heading_row" class="k2-slider-label-row">
                    <ui:Label text="Heading (°)" />
                    <ui:Label tabindex="-1" text="90.0°" display-tooltip-when-elided="true" name="heading_label" class="k2-slider-value-label" />
                </ui:VisualElement>
                <K2UI.K2Compass name="heading" style="margin-top: 7px; margin-bottom: 7px;" />
            </ui:VisualElement>
            <ui:VisualElement name="button_bars" class="k2-button-row">
                <K2UI.ToggleButton name="run" label="Start" class="big" />
            </ui:VisualElement>
            <ui:VisualElement name="status_progress_group" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); margin-top: 10px; margin-bottom: 12px;">
                <ui:VisualElement name="k2_status_row" class="k2-status-row">
                    <K2UI.K2Avatar name="k2_avatar" />
                    <ui:VisualElement name="k2_status_speech" class="k2-status-speech">
                        <K2UI.StatusLine tabindex="-1" text="Status Pilot" name="status_pilot" />
                        <K2UI.Console tabindex="-1" name="pilot_console" text="Console Pilot" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <K2UI.K2ProgressBar name="progress" set-label-to-value="false" value="70.27" max="100" label=" " postfix=" %" style="height: 25px;" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="settings" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); display: none;">
            <ui:Label tabindex="-1" text="No Attitude Settings..." display-tooltip-when-elided="true" name="Title" class="k2-title" />
        </ui:VisualElement>
    </K2UI.Tabs.TabPage>
</ui:UXML>
