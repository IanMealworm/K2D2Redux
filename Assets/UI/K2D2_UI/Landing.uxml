<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <K2UI.Tabs.TabPage name="landing" label="Land" style="display: flex;">
        <ui:VisualElement name="page" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); display: flex;">
            <ui:Label tabindex="-1" text="Landing Autopilot" display-tooltip-when-elided="true" name="Title" class="k2-title" />
            <ui:VisualElement name="collision_status_row" class="advanced-info-row" style="border-bottom-width: 0;">
                <ui:Label text="Collision" class="advanced-info-row-label" />
                <ui:Label text="None detected" name="collision_value" class="advanced-info-row-value" />
            </ui:VisualElement>

            <ui:VisualElement name="landing_mode_group_atmo" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); margin-top: 8px; display: none;">
                <K2UI.K2Toggle label="Precision Landing" name="precision_landing_atmo" tooltip="Land a stage that's coming back down (a boost-back landing) on a chosen site: boost-back burn, steering with the vessel's lift on the way down, then a steered landing burn (atmospheric bodies). Needs Redux's impact prediction set to assume the current attitude (or follow SAS)." />
                <ui:Label tabindex="-1" text="" display-tooltip-when-elided="true" name="precision_landing_gate_atmo" class="k2-note" style="display: none;" />
                <ui:VisualElement name="target_settings_atmo" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0);">
                    <ui:DropdownField label="Waypoint" index="-1" choices="" name="waypoint_drop_atmo" tooltip="Waypoints placed on the current body via Redux's own Waypoints window (list refreshes automatically)" />
                    <ui:FloatField label="Target Latitude" value="0" name="target_latitude_atmo" />
                    <ui:FloatField label="Target Longitude" value="0" name="target_longitude_atmo" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="landing_mode_group_vac" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); margin-top: 8px;">
                <K2UI.K2Toggle label="Precision Landing" name="precision_landing_vac" tooltip="Steer toward a chosen landing site instead of just braking straight down wherever the current course naturally lands (vacuum bodies only)" />
                <ui:Label tabindex="-1" text="" display-tooltip-when-elided="true" name="precision_landing_orbit_gate_vac" class="k2-note" style="display: none;" />
                <ui:VisualElement name="target_settings_vac" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0);">
                    <ui:DropdownField label="Waypoint" index="-1" choices="" name="waypoint_drop_vac" tooltip="Waypoints placed on the current body via Redux's own Waypoints window (list refreshes automatically)" />
                    <ui:FloatField label="Target Latitude" value="0" name="target_latitude_vac" />
                    <ui:FloatField label="Target Longitude" value="0" name="target_longitude_vac" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="button_bars" class="k2-button-row">
                <K2UI.ToggleButton name="run" label="Brake" class="big" />
                <ui:Button text="Touch Down" display-tooltip-when-elided="true" name="touch_down" class="k2-button" tooltip="Go straight to the final Touch Down descent" />
            </ui:VisualElement>
            <ui:VisualElement name="status_progress_group" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); margin-top: 10px; margin-bottom: 12px;">
                <ui:VisualElement name="k2_status_row" class="k2-status-row">
                    <K2UI.K2Avatar name="k2_avatar" />
                    <ui:VisualElement name="k2_status_speech" class="k2-status-speech">
                        <K2UI.StatusLine tabindex="-1" text="Status Pilot" name="status_pilot" />
                        <K2UI.Console tabindex="-1" name="pilot_console" text="Console Pilot" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <K2UI.K2ProgressBar name="progress" set-label-to-value="false" value="70.27" max="100" label=" " postfix=" %" style="height: 25px;" />
            </ui:VisualElement>
            <ui:Foldout text="LANDING INFO" value="false" name="landing_info_foldout">
                <ui:VisualElement name="landing_infos" class="advanced-info-table" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0);" />
            </ui:Foldout>
            <ui:Foldout text="ADVANCED" value="false" name="advanced_foldout">
                <ui:VisualElement name="atmo_settings_panel" style="display: none;">
                    <ui:VisualElement name="PrecisionLanding_atmo">
                        <ui:Label text="// PRECISION LANDING" class="k2-section-header" />
                        <K2UI.K2Slider label-on-top="true" print-value="true" min="0" value="20" max="200" name="max_plane_trim_dv_atmo" label="Max Plane Trim (m/s)" format="N0" tooltip="How much sideways (normal/antinormal) dV the deorbit and entry correction burns may each add to move the ground track toward the target. 0 disables it." />
                        <K2UI.K2Slider label-on-top="true" print-value="true" min="0" value="10" max="30" name="entry_angle_of_attack_atmo" format="N0" label="Entry Angle of Attack (°)" tooltip="How far the vessel is held off retrograde during reentry to make lift for steering. More gives more steering, but exposes more of the vessel to reentry heat." />
                        <K2UI.K2Slider label-on-top="true" print-value="true" min="0" value="10" max="60" name="entry_flight_path_angle_atmo" format="N0" label="Entry Steepness (°)" tooltip="How steeply the deorbit burn brings the vessel into the atmosphere (degrees below the horizon). Steeper costs more delta-v - a lot more from a low orbit - but means less time in the air: less heat soaked up and less drift. 0 keeps the gentlest entry. If the vessel can't afford it, the deorbit flattens it to what it can." />
                        <ui:Label text="Boost-back Flip" tooltip="How a boost-back landing turns the stage round before its burn. Powered: the engines light at once and their gimbals help it turn - quicker for big boosters without much reaction wheel or RCS. Unpowered: turn first, then burn - wastes no fuel turning if the vessel turns quickly on its own." />
                        <K2UI.InlineEnum name="boost_back_flip_atmo" labels="Powered;Unpowered" />
                    </ui:VisualElement>
                    <ui:VisualElement name="Warp_atmo">
                        <ui:Label text="// WARP" class="k2-section-header" />
                        <K2UI.K2Toggle label="Auto Warp" name="auto_warp_atmo" tooltip="Time warp until the landing burn" />
                        <ui:VisualElement name="warp_settings_atmo" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0);">
                            <ui:IntegerField label="Rotation Warp Time (s)" value="42" name="rotation_warp_duration_atmo" tooltip="How long before the burn warp slows down and keeps checking the vessel stays pointed retrograde" />
                            <K2UI.K2Slider label-on-top="true" print-value="true" min="0" value="30" max="90" name="max_rotation_atmo" label="Safe Warp Rotation (°)" format="N0" tooltip="During that last warp, stop warping if the vessel drifts this far off retrograde" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="Brake_atmo">
                        <ui:Label text="// BRAKE" class="k2-section-header" />
                        <K2UI.K2Slider name="burn_before_atmo" tooltip="Start the braking burn this many seconds earlier than worked out" label="Burn Before (s)" format="N1" max="10" print-value="true" label-on-top="true" value="0" min="0" />
                    </ui:VisualElement>
                    <ui:VisualElement name="TouchDown_atmo">
                        <ui:Label text="// TOUCH DOWN" class="k2-section-header" />
                        <K2UI.K2Slider label-on-top="true" print-value="true" format="N0" min="500" value="1500" max="5000" name="start_touchdown_altitude_atmo" label="Touch Down Altitude (m)" tooltip="Height where the final Touch Down descent starts" />
                        <K2UI.K2Slider label-on-top="true" print-value="true" min="5" value="30" max="45" name="touch_down_max_angle_atmo" label="Touch Down Max Angle (°)" format="N0" tooltip="How far the vessel may tilt off vertical during Touch Down" />
                        <K2UI.K2Slider label-on-top="true" print-value="true" min="0.5" value="0.5" max="3" name="touch_down_ratio_atmo" label="Altitude/Speed Ratio" format="N1" tooltip="How quickly the allowed descent speed grows with height" min-max-label="Safe-Danger" />
                        <K2UI.K2Slider label-on-top="true" print-value="true" min="0.1" value="0.2" max="10" name="touch_down_speed_atmo" label="Touch Down Speed (m/s)" format="N1" tooltip="Descent speed at the moment of touchdown" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="vac_settings_panel">
                    <ui:VisualElement name="PrecisionLanding_vac">
                        <ui:Label text="// PRECISION LANDING" class="k2-section-header" />
                        <K2UI.K2Slider label-on-top="true" print-value="true" min="0" value="20" max="200" name="max_plane_trim_dv_vac" label="Max Plane Trim (m/s)" format="N0" tooltip="How much sideways (normal/antinormal) dV the deorbit burn is allowed to add on top of its usual burn, to nudge the orbital plane a little closer to the target. 0 disables it - the deorbit burn only ever picks the best point on whatever plane you're already flying. Meant as a small trim, not a substitute for lining up the plane yourself." />
                    </ui:VisualElement>
                    <ui:VisualElement name="Warp_vac">
                        <ui:Label text="// WARP" class="k2-section-header" />
                        <K2UI.K2Toggle label="Auto Warp" name="auto_warp_vac" tooltip="Time warp until the landing burn" />
                        <ui:VisualElement name="warp_settings_vac" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0);">
                            <ui:IntegerField label="Rotation Warp Time (s)" value="42" name="rotation_warp_duration_vac" tooltip="How long before the burn warp slows down and keeps checking the vessel stays pointed retrograde" />
                            <K2UI.K2Slider label-on-top="true" print-value="true" min="0" value="30" max="90" name="max_rotation_vac" label="Safe Warp Rotation (°)" format="N0" tooltip="During that last warp, stop warping if the vessel drifts this far off retrograde" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="Brake_vac">
                        <ui:Label text="// BRAKE" class="k2-section-header" />
                        <K2UI.K2Slider name="burn_before_vac" tooltip="Start the braking burn this many seconds earlier than worked out" label="Burn Before (s)" format="N1" max="10" print-value="true" label-on-top="true" value="0" min="0" />
                    </ui:VisualElement>
                    <ui:VisualElement name="TouchDown_vac">
                        <ui:Label text="// TOUCH DOWN" class="k2-section-header" />
                        <K2UI.K2Slider label-on-top="true" print-value="true" format="N0" min="500" value="1500" max="5000" name="start_touchdown_altitude_vac" label="Touch Down Altitude (m)" tooltip="Height where the final Touch Down descent starts" />
                        <K2UI.K2Slider label-on-top="true" print-value="true" min="5" value="30" max="45" name="touch_down_max_angle_vac" label="Touch Down Max Angle (°)" format="N0" tooltip="How far the vessel may tilt off vertical during Touch Down" />
                        <K2UI.K2Slider label-on-top="true" print-value="true" min="0.5" value="0.5" max="3" name="touch_down_ratio_vac" label="Altitude/Speed Ratio" format="N1" tooltip="How quickly the allowed descent speed grows with height" min-max-label="Safe-Danger" />
                        <K2UI.K2Slider label-on-top="true" print-value="true" min="0.1" value="0.2" max="10" name="touch_down_speed_vac" label="Touch Down Speed (m/s)" format="N1" tooltip="Descent speed at the moment of touchdown" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:Foldout>
        </ui:VisualElement>
        <ui:VisualElement name="settings" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); display: none;">
            <ui:Label tabindex="-1" text="Landing Settings" display-tooltip-when-elided="true" name="Title" class="k2-title" />
        </ui:VisualElement>
    </K2UI.Tabs.TabPage>
</ui:UXML>
