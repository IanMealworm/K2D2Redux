/* K2D2 window: the pieces that only exist in this window. Shared control styles live in
   K2UI.uss. Loaded last, so these win ties. */

#Main_Icon {
    width: 40px;
    height: 40px;
    align-self: center;
    background-image: url('project://database/Assets/Images/k2d2_big_icon.png?fileID=2800000&guid=8ef988e0f43beb149a76620d7ba3ed65&type=3#k2d2_big_icon');
    margin-bottom: 0;
    translate: -5px -7px;
    position: absolute;
    top: -33px;
    left: 8px;
}

#elevation_field {
    min-width: 48px;
    margin-left: 6px;
    margin-right: 6px;
}

/* Tooltip box (see Tooltips.cs). */
.k2-tooltip {
    padding: 4px 6px;
    background-color: rgb(20, 23, 30);
    border-width: 1px;
    border-color: var(--k2-color-border);
    border-radius: 3px;
    color: var(--k2-color-text-bright);
    font-size: var(--k2-size-info);
    white-space: normal;
    min-width: 0;
}

/* The game's notched box around the tabs and their content, like the Transfer Window mod's main
   panel (UitkForKsp2's InvertedCornerBox draws the outline and fill). */
.k2-main-box {
    flex-grow: 1;
    padding: 4px 2px 4px 4px;
}

/* ===== Footer toolbar ===== */

/* Leaves room for the resize handle in the bottom-right corner. */
#toolbar {
    padding-right: 28px;
}

/* Auto-staging: a small checkbox to the left of its label (row-reverse, since ToggleButton adds
   its label first). */
#staging-toggle {
    flex-direction: row-reverse;
    align-items: center;
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
    border-width: 0;
    width: auto;
    height: 22px;
    padding-left: 6px;
    padding-right: 6px;
    margin: 0;
}

#staging-toggle > Label {
    color: var(--k2-color-text);
    -unity-text-align: middle-left;
    margin-left: 6px;
}

#staging-toggle #icon {
    width: 12px;
    height: 12px;
    background-color: rgba(0, 0, 0, 0.25);
    background-image: none;
    border-width: 1px;
    border-color: rgb(87, 95, 111);
    border-radius: 2px;
}

#staging-toggle.checked #icon {
    border-color: var(--k2-color-accent);
    background-image: url('project://database/Assets/Images/check_mark.png?fileID=2800000&guid=e3c3e3c326f7490489afafc91d2db028&type=3#check_mark');
    -unity-background-image-tint-color: var(--k2-color-accent);
    background-repeat: no-repeat;
    background-position: center;
    background-size: 8px 8px;
}

/* The info button that opens the About tab: one of K2D2's own square buttons (k2-button
   k2-button--square in K2UI.uss), the same height as the auto-staging toggle beside it. */
#info-toggle {
    width: 24px;
    height: 22px;
}
