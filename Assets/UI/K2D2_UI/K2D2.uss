.root {
}

#Main_Icon {
    width: 40px;
    height: 40px;
    align-self: center;
    background-image: url('project://database/Assets/Images/k2d2_big_icon.png?fileID=2800000&guid=8ef988e0f43beb149a76620d7ba3ed65&type=3#k2d2_big_icon');
    margin-bottom: 0;
    translate: -5px -7px;
    position: absolute;
    top: -33px;
    left: 8px;
}

.big {
    font-size: 14px;
}

/* K2UI.StatusLine (run-status messages like "No Maneuver node.", shown via the shared
   StatusGroup.uxml template - reaches every tab): K2UI.uss's own .k2-status-line rule points
   it at NotoSansMonoCJK instead of the stock JetBrains Mono body font used everywhere else.
   Same tie-specificity/load-order issue as the progress bar (K2UI.uss loads after K2D2.uss),
   so !important - this is scoped to just this one class, not a blanket override, so it won't
   touch .console/.oab-button__label's own intentional fonts. */
.k2-status-line {
    -unity-font-definition: url('project://database/Packages/uitkforksp2.controls/Assets/Theme/Fonts/JetBrainsMono/JetBrainsMono-Regular%20SDF.asset?fileID=11400000&guid=f5454c9c675002c44a5a7234bd40c390&type=2#JetBrainsMono-Regular SDF') !important;
}

/* K2UI.Console ("Node Infos" / dV / duration readouts, and every other tab's console-style
   text panel) - K2UI.uss's own .console rule hardcodes a completely different font (Sax Mono,
   a K2D2-specific asset, not part of the stock theme at all) plus its own color. Same class-
   beats-type override problem as .k2-status-line above, so it never picked up the generic
   Label rule below - fixed the same way. */
.console {
    -unity-font-definition: url('project://database/Packages/uitkforksp2.controls/Assets/Theme/Fonts/JetBrainsMono/JetBrainsMono-Regular%20SDF.asset?fileID=11400000&guid=f5454c9c675002c44a5a7234bd40c390&type=2#JetBrainsMono-Regular SDF') !important;
    color: rgb(192, 199, 213) !important;
}

/* Ports the stock KerbalUI body font (JetBrains Mono) + text color onto plain Labels site-wide.
   KerbalUI.uss sets these same values on :root, which should inherit down to every Label - but
   in testing that inheritance wasn't reliably reaching labels loaded from separate tab
   templates (node.uxml, about.uxml, etc.), the same lesson learned from the Debug Mode CSS
   diagnosis - so it's set explicitly here instead. More specific rules below (.console,
   #run > Label, etc.) still win over this via their own higher-specificity selectors. */
Label {
    -unity-font-definition: url('project://database/Packages/uitkforksp2.controls/Assets/Theme/Fonts/JetBrainsMono/JetBrainsMono-Regular%20SDF.asset?fileID=11400000&guid=f5454c9c675002c44a5a7234bd40c390&type=2#JetBrainsMono-Regular SDF');
    color: rgb(192, 199, 213);
}

/* Restyles the About tab's "debug" K2UI.ToggleButton to match the stock KerbalUI
   .oab-button-toggle palette (see Packages/uitkforksp2.controls/Assets/Theme/KerbalUI.uss).
   Kept as K2UI.ToggleButton rather than swapping to a native Toggle + .oab-button-toggle,
   since AboutUI.cs binds it via K2UI.ToggleButton's own .Bind(SettingsField) extension -
   this only ports the stock colors/font onto K2UI.ToggleButton's own class structure
   (.toggle-button / .checked / > Label, from ToggleButton.uss). #debug is used instead of
   a shared class so these rules win regardless of stylesheet load order. */
/* Reese liked #reset_all's font (it never overrides one, so it just falls through to the
   generic Label rule above - plain JetBrains Mono Regular) better than the SFPixelate bold
   this block and #run below used to carry, so both now point at that same JetBrains Mono
   Regular SDF asset instead, matching Reset All Settings/#reset_advanced without needing
   their own override at all. */
/* Same pixel-bevel treatment as #run/#pause below, toned down - see that block's comment for why
   this has to be an ID selector and how the bevel itself is built. Debug Mode keeps its own
   established purple "settings toggle" color instead of the green used for Start/Pause's
   running state, since this isn't an active-process indicator. */
#debug {
    background-color: rgb(225, 227, 233);
    background-image: none;
    flex-basis: 0;
    border-width: 2px 3px 4px 2px;
    border-color: rgb(35, 35, 42) rgb(170, 172, 180) rgb(120, 122, 130) rgb(35, 35, 42);
    border-radius: 3px;
}

#debug:hover {
    background-color: rgb(238, 240, 245);
}

#debug:active {
    background-color: rgb(210, 212, 218);
    translate: 1px 1px;
}

#debug.checked {
    background-image: none;
    background-color: rgb(188, 161, 255);
    border-color: rgb(50, 35, 75) rgb(216, 200, 255) rgb(150, 120, 210) rgb(50, 35, 75);
}

#debug.checked:hover {
    background-color: rgb(206, 190, 255);
}

/* "Reset All Settings" is a stock UitkForKsp2.Controls.OabButton (Button -> .oab-button__inner ->
   .oab-button__label), not a K2UI.ToggleButton like the others on this page - same bevel look
   applied directly to the button itself, with its label recolored to match since the stock
   .oab-button__label styling assumes a dark button face, not this light one. */
/* flex-basis: 0 (instead of the default "auto", which sizes each flex item off its own content
   width before growing) makes Reset All Settings and Debug Mode split buttons_bar's width
   exactly evenly - with flex-basis:auto, OabButton's slightly different intrinsic padding/font
   metrics vs. K2UI.ToggleButton's meant the two never came out equal despite both already having
   flex-grow:1 in the uxml. */
#reset_all {
    background-color: rgb(225, 227, 233);
    background-image: none;
    flex-basis: 0;
    border-width: 2px 3px 4px 2px;
    border-color: rgb(35, 35, 42) rgb(170, 172, 180) rgb(120, 122, 130) rgb(35, 35, 42);
    border-radius: 3px;
}

#reset_all:hover {
    background-color: rgb(238, 240, 245);
}

#reset_all:active {
    background-color: rgb(210, 212, 218);
    translate: 1px 1px;
}

/* OabButton's own stock KerbalUI style (.oab-button.unity-text-element > .oab-button__inner)
   paints an opaque flat-gray fill AND its own separate 7px-rounded corners on this inner wrapper,
   regardless of what's set on the button itself - that's what was actually showing through as the
   button's face, sitting inside the bevel border above rather than being replaced by it, which is
   why this looked visibly different from Debug Mode (a plain K2UI.ToggleButton with no such
   nested layer). Made fully transparent in every state so only the outer #reset_all bevel paints. */
#reset_all > .oab-button__inner,
#reset_all:hover > .oab-button__inner,
#reset_all:active > .oab-button__inner {
    background-color: rgba(0, 0, 0, 0);
    border-radius: 0;
}

#reset_all .oab-button__label {
    color: rgb(34, 38, 46);
    font-size: 14px;
}

/* Node/Lift tabs: the settings Reset button, relocated to the bottom of each tab's own ADVANCED
   foldout (see K2Page.cs's addResetButton) now that the settings-gear page it used to live on is
   on its way out. Same bevel as Debug Mode/Reset All Settings - this one's a plain Unity Button
   (not an OabButton), so unlike #reset_all there's no nested .oab-button__inner/label to also
   neutralize - the color/background/border all land directly on the element itself. */
#reset_advanced {
    background-color: rgb(225, 227, 233);
    background-image: none;
    color: rgb(34, 38, 46);
    font-size: 14px;
    border-width: 2px 3px 4px 2px;
    border-color: rgb(35, 35, 42) rgb(170, 172, 180) rgb(120, 122, 130) rgb(35, 35, 42);
    border-radius: 3px;
}

#reset_advanced:hover {
    background-color: rgb(238, 240, 245);
}

#reset_advanced:active {
    background-color: rgb(210, 212, 218);
    translate: 1px 1px;
}

/* ToggleButton.uss's ".toggle-button.big > Label" rule sets an explicit font-size: 17px (plus
   the SFPixelate-era bold) - that's a plain class selector so it loses the font-FAMILY fight to
   this ID selector, but font-size/weight are properties this rule never touched, so they kept
   falling through from that class rule untouched. That's why Debug Mode/Start/Brake still looked
   "off" against Reset All Settings/Touch Down after the font swap - same family, different size.
   Pinned to 14px here to match #reset_all/#reset_advanced/#touch_down below, none of which are
   .toggle-button.big elements so none of them ever got the 17px override in the first place. */
#debug > Label {
    color: rgb(34, 38, 46);
    font-size: 14px;
    -unity-font-style: normal;
    -unity-font-definition: url('project://database/Packages/uitkforksp2.controls/Assets/Theme/Fonts/JetBrainsMono/JetBrainsMono-Regular%20SDF.asset?fileID=11400000&guid=f5454c9c675002c44a5a7234bd40c390&type=2#JetBrainsMono-Regular SDF') !important;
}

#debug.checked > Label {
    color: rgb(34, 38, 46) !important;
}

/* Node tab: Start/Pause toggle buttons. Originally just ported the stock KerbalUI oab-button-
   toggle palette (flat fill, thin uniform border) - now redone as Reese's pixel-art 3D "PAUSE"/
   "PLAY" bevel reference. This has to live HERE, as an ID selector, not as the .toggle-button.big
   class rules over in ToggleButton.uss: an ID selector always wins a specificity fight against
   any class selector regardless of which stylesheet loads later, so those .big rules were being
   silently overridden by this block the entire time - same lesson as the #debug case above.
   UI Toolkit has no real box-shadow/gradient, so the bevel is faked with asymmetric border
   widths/colors: a dark keyline all round, a light face, and heavier right/bottom borders in
   darker shades standing in for the block's own right-side and underside faces - the diagonal
   seam where they meet at the corner falls out for free from how adjacent border colors miter.
   Reese: the first pass read as too heavy/3D - thinner borders and less contrast between the
   face/right-face/bottom-face shades tones it down while keeping the same bevel shape. Explicit
   height here (not left to each button's own natural sizing) also fixes Pause reading shorter
   than Start - #pause was capped at .toggle-button.big.icon's own height:30px (inside the same
   border-box as its now-thicker border, shrinking its content) while #run had no explicit height
   at all, so the two drifted apart the instant the borders got heavier. */
#run, #pause {
    background-color: rgb(225, 227, 233);
    background-image: none;
    height: 32px;
    border-width: 2px 3px 4px 2px;
    border-color: rgb(35, 35, 42) rgb(170, 172, 180) rgb(120, 122, 130) rgb(35, 35, 42);
    border-radius: 3px;
}

#run:hover, #pause:hover {
    background-color: rgb(238, 240, 245);
}

/* Pressed reads as the block nudging down into its own shadow rather than resizing it (changing
   border-width here would jitter the button's layout size). */
#run:active, #pause:active {
    background-color: rgb(210, 212, 218);
    translate: 1px 1px;
}

/* Checked (running) state re-themed to the reference's own green "PLAY" bevel - same block shape,
   still the stock "confirm" green family used elsewhere in this theme (progress bar fill, etc.). */
#run.checked, #pause.checked {
    background-image: none;
    background-color: rgb(46, 204, 92);
    border-color: rgb(20, 60, 32) rgb(110, 200, 140) rgb(50, 150, 80) rgb(20, 60, 32);
}

#run.checked:hover, #pause.checked:hover {
    background-color: rgb(66, 224, 112);
}

/* Same font-size fix as #debug > Label above - .toggle-button.big > Label's own font-size: 17px
   survived the earlier font-family swap since that rule never touched size, only family. */
#run > Label {
    color: rgb(34, 38, 46) !important;
    font-size: 14px;
    -unity-font-style: normal;
    -unity-font-definition: url('project://database/Packages/uitkforksp2.controls/Assets/Theme/Fonts/JetBrainsMono/JetBrainsMono-Regular%20SDF.asset?fileID=11400000&guid=f5454c9c675002c44a5a7234bd40c390&type=2#JetBrainsMono-Regular SDF') !important;
}

#run.checked > Label {
    color: rgb(34, 38, 46) !important;
}

/* pause's icon (pause.png) is a plain white glyph - legible on the old near-black button
   background, but not on the new light-gray/purple fills - so tint it dark in both states. */
#pause #icon {
    -unity-background-image-tint-color: rgb(34, 38, 46);
}

/* Landing's Touch Down button - was a completely unstyled stock ui:Button, now given the same
   light-gray pixel-bevel as Brake (#run) sits next to it, so the two read as one matched pair
   instead of a themed button next to a plain default one. Plain Unity Button (not an OabButton),
   so same as #reset_advanced there's no nested .oab-button__inner/label to separately neutralize
   - color/background/border land directly on the element, and its text already gets the shared
   JetBrains Mono Regular from the base Label rule with no override needed here, same as
   #reset_all/#reset_advanced. No .checked state since this is a one-shot action button, not a
   toggle. */
#touch_down {
    background-color: rgb(225, 227, 233);
    background-image: none;
    color: rgb(34, 38, 46);
    font-size: 14px;
    height: 32px;
    border-width: 2px 3px 4px 2px;
    border-color: rgb(35, 35, 42) rgb(170, 172, 180) rgb(120, 122, 130) rgb(35, 35, 42);
    border-radius: 3px;
}

#touch_down:hover {
    background-color: rgb(238, 240, 245);
}

#touch_down:active {
    background-color: rgb(210, 212, 218);
    translate: 1px 1px;
}

/* Dock tab: Main Thrust Brake/RCS Final Approach - same plain-Button bevel treatment as Touch
   Down above (no nested .oab-button__inner/label, no .checked state - one-shot mode-select
   buttons, not toggles). Align Dock (a K2Toggle) and Stop/Start (already themed via the shared
   "#run" id) didn't need this. Small margin-top since these stack in a column (button_bars) with
   Stop/Start above them, rather than sitting side-by-side in a row like Brake/Touch Down. */
#main_brake, #rcs_final_approach {
    background-color: rgb(225, 227, 233);
    background-image: none;
    color: rgb(34, 38, 46);
    font-size: 14px;
    height: 32px;
    margin-top: 4px;
    border-width: 2px 3px 4px 2px;
    border-color: rgb(35, 35, 42) rgb(170, 172, 180) rgb(120, 122, 130) rgb(35, 35, 42);
    border-radius: 3px;
}

#main_brake:hover, #rcs_final_approach:hover {
    background-color: rgb(238, 240, 245);
}

#main_brake:active, #rcs_final_approach:active {
    background-color: rgb(210, 212, 218);
    translate: 1px 1px;
}

/* Attitude tab: Elevation's -/+ stepper (RepeatButton, held down to repeat-step - see
   AttitudeUI.cs's SetAction calls). These came from a stock RepeatButton preset ("unity-button
   fixed-button icon-right" in attitude.uxml) that rendered as a plain dark dashed-border button,
   the only unstyled controls left on this tab - same bevel treatment as Touch Down/Main Brake
   above, just square instead of a full-width bar. Sized to sit snugly on either side of the
   FloatField rather than stretching, hence no flex-grow here (unlike the full-width buttons
   above). */
#elevation_n_rb, #elevation_p_rb {
    background-color: rgb(225, 227, 233);
    background-image: none;
    color: rgb(34, 38, 46);
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    width: 26px;
    height: 24px;
    border-width: 2px 3px 4px 2px;
    border-color: rgb(35, 35, 42) rgb(170, 172, 180) rgb(120, 122, 130) rgb(35, 35, 42);
    border-radius: 3px;
}

#elevation_n_rb:hover, #elevation_p_rb:hover {
    background-color: rgb(238, 240, 245);
}

#elevation_n_rb:active, #elevation_p_rb:active {
    background-color: rgb(210, 212, 218);
    translate: 1px 1px;
}

/* The FloatField between them used to sit flush against both buttons with no breathing room at
   all (see attitude.uxml) - a small side margin on the field itself is simpler than margins on
   both buttons since it only has to be set in one place. */
#elevation_field {
    margin-left: 6px;
    margin-right: 6px;
}

/* Brake and Touch Down both already carry flex-grow:1 in their uxml, but flex-grow alone splits
   space starting from each item's own content-based width (flex-basis:auto) - since "Brake"/
   "Stop" and "Touch Down" aren't the same width, that alone doesn't produce two equal-size
   buttons, same root cause as the Reset All Settings/Debug Mode mismatch above. flex-basis:0
   makes both start from zero and split the row exactly evenly. Scoped to "#landing" (the Landing
   TabPage's own name/id) rather than a bare "#run" so this doesn't reach Node/Lift's Start, which
   share the same "button_bars" container name for their own, differently-composed row (Start +
   the fixed-size Pause icon button, not a second flex-grow item to balance against). */
#landing #button_bars #run, #landing #button_bars #touch_down {
    flex-basis: 0;
}

/* ToggleButton.uss's base ".toggle-button" rule gives Brake its own built-in
   2px/2px/2px/4px (left/right/top/bottom) margin, meant for generic toggle buttons elsewhere -
   Touch Down (a plain Button, not a .toggle-button) never had that, and instead got its spacing
   from explicit margins in the uxml. Two flex items with different margins end up different
   sizes even at equal flex-basis/flex-grow, since margin is reserved outside each item's own box
   rather than shared - zeroed out here (scoped to "#landing" specifically, same reasoning as the
   flex-basis rule above - a bare "#button_bars #run" previously also caught Node's Start button,
   stripping the margin it shares with Pause and throwing that pair back out of alignment with
   each other) so Brake's box matches Touch Down's; the visible gap between the two still comes
   from Touch Down's own margin-left in the uxml. */
#landing #button_bars #run {
    margin-top: 0;
    margin-bottom: 0;
    margin-left: 0;
    margin-right: 0;
}

/* Same fix as #button_bars #run above, for the About tab's own Reset All Settings/Debug Mode
   row (named "buttons_bar", singular, not "button_bars") - Debug Mode is a K2UI.ToggleButton so
   it inherits .toggle-button's built-in margin, Reset All Settings (an OabButton) doesn't and
   instead gets its spacing from an explicit margin-right in the uxml. Zeroing Debug Mode's here
   leaves the gap between them coming from just that one explicit margin, same box width both
   sides. */
#buttons_bar #debug {
    margin-top: 0;
    margin-bottom: 0;
    margin-left: 0;
    margin-right: 0;
}

/* Tab bar (Node/Lift/Land/Dock/Att.) - redesigned to match the flat "underline" tab style from
   Reese's other-mod reference screenshot (plain text row, dim/gray for unselected, bright/bold
   + a colored underline for the selected tab, no boxes or fills at all) rather than the boxed/
   filled pill-tab look from the first pass. K2Tabs.uss's base rule gives every tab a full
   rounded-box border (top-left/right radius, border on all 4 sides) - this flattens that out to
   just a bottom border, repurposed as the underline indicator. Green matches the same "confirm/
   active" green used for Start and the progress bar elsewhere in this theme.

   DIAGNOSIS of why the first pass at this block (plain .k2-tabsbar/.k2-tab-button/
   .k2-tab-button--active class selectors, all !important) never visually applied in-game:
   every OTHER override in this file that reliably wins a tie-specificity fight against a
   later-loaded stylesheet does so via an ID selector anchored on the actual target element
   (#debug, #run, #pause, #Main_Icon, and - closest precedent - ".k2-progress-bar #frame" /
   "#progress", which pairs a class-selector ancestor with an ID on the element actually being
   styled). This tab-bar block was the only override in K2D2.uss using bare class selectors with
   no ID anchor anywhere in the chain, and empirically it's the only one that silently failed to
   apply. TabPage.setButton() (K2UI/Tabs/TabButton.cs) copies each TabPage's UXML "name" onto its
   TabButton, so every tab button already has a unique, stable id matching its tab page's name
   (node/lift/landing/dock/attitude/about) - reusing that id, scoped under "#TabsBar" (the id
   TabbedPage.Setup() gives the tab bar itself) to avoid colliding with the identically-named
   TabPage content elements living elsewhere in the tree, gives every rule below the same
   ID-anchored shape as the overrides that are confirmed working. */
#TabsBar {
    border-color: rgba(60, 62, 146, 0.35) !important;
    border-bottom-width: 1px !important;
}

#TabsBar #node, #TabsBar #lift, #TabsBar #landing, #TabsBar #dock, #TabsBar #attitude, #TabsBar #about {
    background-color: rgba(0, 0, 0, 0) !important;
    border-left-width: 0 !important;
    border-right-width: 0 !important;
    border-top-width: 0 !important;
    border-bottom-width: 1px !important;
    border-bottom-color: rgba(0, 0, 0, 0) !important;
    border-top-left-radius: 0 !important;
    border-top-right-radius: 0 !important;
    border-bottom-left-radius: 0 !important;
    border-bottom-right-radius: 0 !important;
    margin-bottom: 0 !important;
    margin-left: 0 !important;
    /* K2Tabs.uss's base rule gives every button flex-grow: 0 (size-to-content, packed left by
       .k2-tabsbar's justify-content: flex-start) - grow: 1 makes all 5 buttons split the bar's
       width evenly instead, so the row reads as one evenly-spaced strip rather than a
       left-anchored cluster. Label centering (-unity-text-align: middle-center) already comes
       from K2Tabs.uss's own ".k2-tab-button > Label" rule, so text stays centered in each slot. */
    flex-grow: 1 !important;
}

#TabsBar #node > Label, #TabsBar #lift > Label, #TabsBar #landing > Label, #TabsBar #dock > Label, #TabsBar #attitude > Label, #TabsBar #about > Label {
    color: rgb(120, 128, 145) !important;
    -unity-font-definition: url('project://database/Packages/uitkforksp2.controls/Assets/Theme/Fonts/JetBrainsMono/JetBrainsMono-Regular%20SDF.asset?fileID=11400000&guid=f5454c9c675002c44a5a7234bd40c390&type=2#JetBrainsMono-Regular SDF') !important;
    -unity-font-style: normal !important;
    letter-spacing: 1px;
}

#TabsBar #node:hover, #TabsBar #lift:hover, #TabsBar #landing:hover, #TabsBar #dock:hover, #TabsBar #attitude:hover, #TabsBar #about:hover {
    background-color: rgba(255, 255, 255, 0.04) !important;
}

#TabsBar #node:active, #TabsBar #lift:active, #TabsBar #landing:active, #TabsBar #dock:active, #TabsBar #attitude:active, #TabsBar #about:active {
    background-color: rgba(255, 255, 255, 0.07) !important;
}

/* A full-width border-bottom can't be narrowed below the button's own width - USS borders always
   span the full box - so the selection indicator is a small tinted image (tab_underline.png, a
   plain 8x8 white square, same "white asset + CSS tint" pattern as #pause #icon below) instead,
   sized down to a short strip and centered at the bottom of the button. Border-bottom-color goes
   back to transparent so it doesn't double up with the image. */
#TabsBar #node.k2-tab-button--active, #TabsBar #lift.k2-tab-button--active, #TabsBar #landing.k2-tab-button--active, #TabsBar #dock.k2-tab-button--active, #TabsBar #attitude.k2-tab-button--active, #TabsBar #about.k2-tab-button--active {
    background-color: rgba(0, 0, 0, 0) !important;
    border-bottom-color: rgba(0, 0, 0, 0) !important;
    background-image: url('project://database/Assets/Images/tab_underline.png?fileID=2800000&guid=8fe0d00951b4482e921b0a7d1cd22b4a&type=3#tab_underline') !important;
    -unity-background-image-tint-color: rgb(0, 204, 83) !important;
    background-repeat: no-repeat !important;
    background-position: center bottom !important;
    background-size: 22px 2px !important;
}

#TabsBar #node.k2-tab-button--active > Label, #TabsBar #lift.k2-tab-button--active > Label, #TabsBar #landing.k2-tab-button--active > Label, #TabsBar #dock.k2-tab-button--active > Label, #TabsBar #attitude.k2-tab-button--active > Label, #TabsBar #about.k2-tab-button--active > Label {
    color: rgb(230, 233, 238) !important;
    -unity-font-style: bold !important;
    /* K2Tabs.uss's own ".k2-tab-button--active > Label" rule bumps font-size to 16px (vs. the
       14px every other tab label gets from its ".k2-tab-button > Label" rule) - that's what was
       making the active tab visibly grow when pressed. Selection is already communicated by the
       underline + bold + brighter text, so pin it back to the same 14px as the unselected tabs
       and let only those three cues carry the "active" state, not a size jump. */
    font-size: 14px !important;
}

/* K2ProgressBar (K2UI.K2ProgressBar, used inside the shared StatusGroup.uxml template - so
   this reaches every tab, not just Node): dark stock-style panel with a beveled "3D" frame
   (lighter top/left border, darker bottom/right border - same bevel technique used elsewhere
   in this theme to fake a raised look without needing an image asset) and a fill that matches
   the Start button's checked-state green, so the two read as the same "running" indicator.
   The fill also gets a tileable diagonal-stripe texture (Assets/Images/progress_stripes.png -
   translucent white stripes over transparency, so the green shows through) via
   background-repeat, the same tiling technique KerbalUI.uss itself uses for its dashed
   separator line. Same selectors as the base rules in K2UI.uss - using !important since, per
   the Debug Mode diagnosis, load order isn't reliable for tie-specificity selectors like these. */
.k2-progress-bar #frame {
    background-color: rgb(41, 47, 57) !important;
    border-top-color: rgb(110, 118, 135) !important;
    border-left-color: rgb(110, 118, 135) !important;
    border-bottom-color: rgb(20, 22, 28) !important;
    border-right-color: rgb(20, 22, 28) !important;
    border-width: 2px !important;
}

.k2-progress-bar #progress {
    background-color: rgb(0, 204, 83) !important;
    background-image: url('project://database/Assets/Images/progress_stripes.png?fileID=2800000&guid=1c50209de9094733b71cf44a7f1f5b18&type=3#progress_stripes') !important;
    background-repeat: repeat !important;
    background-size: 16px 16px !important;
}

/* K2Tabs.uss's #tab_light was a separate "pilot is running" indicator (unrelated to tab
   selection), restyled as a small pixelated dot in each tab's top-right corner (see git history
   for the full backstory on that pass). Reese: remove it outright - only one autopilot can
   actually be running at a time (K2D2_Plugin.ResetControllers() stops whichever pilot was active
   the moment a different one starts), so it never showed more than one tab lit anyway and wasn't
   worth the extra chrome. Hidden via the same ID-anchored selectors that were needed to style it
   in the first place - a bare ".k2-tab-button #tab_light { display: none; }" won't reliably apply
   here for the same specificity reason a plain hide attempt failed when this was first touched:
   these runtime-built TabButton elements only reliably take overrides when every element in the
   selector chain is ID-anchored, same as "#TabsBar #node" etc. below. */
#TabsBar #node #tab_light, #TabsBar #lift #tab_light, #TabsBar #landing #tab_light, #TabsBar #dock #tab_light, #TabsBar #attitude #tab_light, #TabsBar #about #tab_light {
    display: none !important;
}

/* Node tab's "Advanced Info" dropdown (formerly an always-visible console block near the top,
   now a collapsed-by-default Foldout at the bottom of the page) - dark theme-matching header,
   dashed-feeling top border to separate it from whatever's above it. .unity-toggle__text is a
   stable built-in UI Toolkit class name for a Toggle's own label (Foldout's header is a Toggle
   under the hood), not something specific to this project, so this should hold up across Unity
   versions better than guessing at Foldout's internal element structure. */
/* Node Info (live readout) and Advanced (Turn/Warp/Burn/Experimental settings) are Node tab's
   two top-level dropdowns. Header look (font-size/color/letter-spacing/header-bar background) now
   comes entirely from K2UI.uss's shared .unity-foldout rules - the "// LABEL" category-header
   treatment matching the RCS Thruster reference - so these two no longer need their own
   bold/color override; top-level and nested (Turn/Warp/Burn/Experimental) headers intentionally
   share the same look now, same as the reference's category headers. Just a small top margin
   left for breathing room from whatever's above. */
#node_info_foldout, #advanced_info_foldout {
    margin-top: 6px;
}

/* Advanced Info's table rows (node_infos, built in NodeExUI.cs's AddInfoRow) - dim label on the
   left, bold value on the right, thin separator between rows, loosely matching the stock Parts
   Manager reference panel's "row read" look. */
.advanced-info-table {
    margin-top: 4px;
}

.advanced-info-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-top: 3px;
    padding-bottom: 3px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(87, 95, 111, 0.25);
}

.advanced-info-row-label {
    color: rgb(140, 148, 163);
    font-size: 12px;
}

.advanced-info-row-value {
    color: rgb(230, 233, 238);
    -unity-font-style: bold;
    font-size: 12px;
}

/* Auto-staging toggle (window footer toolbar) - restyled from an icon-only mini button into a
   labeled checkbox: a small square LED (tab_underline.png, the same white-square + CSS-tint
   asset the tab selection indicator uses) that tints green when checked, to the left of an
   "Auto-staging" label. See K2D2_Window.uxml's comment for why row-reverse is needed to get the
   icon on the left of the label. */
#staging-toggle {
    flex-direction: row-reverse;
    align-items: center;
    background-color: rgba(0, 0, 0, 0) !important;
    background-image: none !important;
    border-width: 0 !important;
    width: auto;
    height: 22px;
    padding-left: 6px;
    padding-right: 6px;
    margin: 0;
}

#staging-toggle > Label {
    color: rgb(192, 199, 213) !important;
    -unity-text-align: middle-left;
    margin-left: 6px;
}

/* Reworked from a plain tinted-square LED into an actual checkbox: a bordered box in both
   states, with a small pixelated checkmark (check_mark.png, generated the same way as
   tab_underline.png - a transparent PNG tinted via CSS) appearing only once checked, alongside
   the border itself turning green. */
#staging-toggle #icon {
    width: 12px;
    height: 12px;
    background-color: rgba(0, 0, 0, 0.25);
    background-image: none;
    border-width: 1px;
    border-color: rgb(87, 95, 111);
    border-radius: 2px;
}

#staging-toggle.checked #icon {
    border-color: rgb(0, 204, 83);
    background-image: url('project://database/Assets/Images/check_mark.png?fileID=2800000&guid=e3c3e3c326f7490489afafc91d2db028&type=3#check_mark');
    -unity-background-image-tint-color: rgb(0, 204, 83);
    background-repeat: no-repeat;
    background-position: center;
    background-size: 8px 8px;
}

/* SUPERSEDED - the settings gear/page mechanism is gone, replaced by the #info-toggle button
   below, which jumps straight to the About tab instead of toggling a shared settings pane.
   (Old gear art comment kept only in git history, not worth preserving here.)

   New info button: Reese's reference image was a pixel-art blue circular info badge, so this is
   built CSS-only (no new PNG/GUID asset) using the same bevel language as the rest of the mod's
   buttons - a circular blue face, a dark navy outer border standing in for the pixel-bevel shadow
   edge, and a lighter blue top/left highlight - with the "i" set directly as the Button's text
   rather than a separate icon child. */
#info-toggle {
    width: 25px;
    height: 25px;
    border-radius: 50%;
    background-color: rgb(96, 170, 235);
    border-left-width: 2px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(150, 205, 250);
    border-top-color: rgb(150, 205, 250);
    border-right-color: rgb(15, 30, 70);
    border-bottom-color: rgb(15, 30, 70);
    -unity-font-style: bold;
    font-size: 14px;
    color: rgb(15, 30, 70);
    -unity-text-align: middle-center;
    padding: 0;
    margin: 0;
}

#info-toggle:hover {
    background-color: rgb(120, 190, 250);
}

#info-toggle:active {
    background-color: rgb(75, 145, 205);
    border-left-color: rgb(15, 30, 70);
    border-top-color: rgb(15, 30, 70);
    border-right-color: rgb(150, 205, 250);
    border-bottom-color: rgb(150, 205, 250);
}

/* Clears room for the bottom-right resize handle (see ResizeManipulator.cs/K2D2_Window.uxml) so
   it doesn't sit directly on top of the toolbar's rightmost button. Both are absolutely
   positioned at right:0/bottom:0 of the same containing box (the AppShell content area - the
   toolbar row is its last in-flow child, so its bottom-right corner IS that box's bottom-right
   corner), so without this the two controls would occupy the exact same ~24x24px square.
   Shifting the whole toolbar row left by the handle's width moves the button clear of that
   corner instead. */
#toolbar {
    padding-right: 28px;
}

