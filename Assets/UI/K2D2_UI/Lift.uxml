<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <K2UI.Tabs.TabPage name="lift" label="Lift" style="display: flex;">
        <ui:VisualElement name="page" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); display: flex;">
            <ui:Label tabindex="-1" text="Ascent Autopilot" display-tooltip-when-elided="true" name="Title" class="k2-title" />
            <ui:Foldout text="PROFILE" value="false" name="profile">
                <ui:DropdownField label="Ascent Profile" index="0" choices="Guided,Gravity Turn (Experimental)" name="ascent_profile_drop" style="justify-content: space-between;" tooltip="Guided: fixed pitch-over curve (original K2D2 behavior). Gravity Turn (Experimental): holds prograde and modulates throttle to hold a target time-to-apoapsis, closer to a real rocket's ascent. Still being tuned - unusual rockets may need Auto Kick &amp; Hold off and gentler settings." />
                <ui:IntegerField label="Target Apoapsis (km)" value="42" name="destination_Ap_km" tooltip="The apoapsis the ascent aims for" style="justify-content: space-between;" />
                <ui:VisualElement name="guided_profile_settings">
                    <K2UI.K2Slider name="end_rotate_ratio" tooltip="Altitude where the climb has leaned over to 5° above the horizon" label="5° Alt" max="10" print-value="false" label-on-top="true" value="0" min="0.01" />
                    <K2UI.K2Slider name="mid_rotate_ratio" tooltip="Altitude where the climb has leaned over to 45°" label="45° Alt" max="10" print-value="false" label-on-top="true" value="0.98" min="0.01" />
                    <ui:IntegerField label="90° Alt (km)" value="42" name="start_altitude_km" tooltip="Altitude where the rocket starts leaning over from straight up" style="justify-content: space-between;" />
                    <K2UI.K2Toggle label="Roll Program" name="roll_program" tooltip="Roll the vessel to a chosen offset from its launch orientation once it clears the altitude below" />
                    <ui:VisualElement name="roll_program_settings">
                        <K2UI.K2Slider label-on-top="true" print-value="true" min="0" value="0.1" max="5" name="roll_program_altitude_km" label="Roll Program Altitude (km)" format="N1" tooltip="Altitude at which the roll program executes" />
                        <K2UI.K2Slider label-on-top="true" print-value="true" min="-180" value="0" max="180" name="roll_program_angle_deg" label="Roll Program Angle (°)" format="N0" tooltip="How many degrees to roll from the vessel's launch orientation (not an absolute compass heading)" />
                        <K2UI.K2Slider label-on-top="true" print-value="true" min="0.5" value="3" max="15" name="roll_program_rate_deg_s" label="Roll Program Rate (°/s)" format="N1" tooltip="How fast the roll program is allowed to roll the vessel toward its target angle - lower is gentler but takes longer, higher settles faster but risks overshoot" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="gravity_turn_settings">
                    <K2UI.K2Toggle label="Auto Kick &amp; Hold" name="gravity_turn_auto" tooltip="Works out the best Pitch Kick and Hold Time for this rocket just before the kick, from its measured drag and its stages. Turn this off to set Pitch Kick and Hold Time yourself. Their last values are also used if it can't make a plan" />
                    <K2UI.K2Slider label-on-top="true" print-value="true" min="10" value="100" max="300" name="gravity_turn_kick_speed_mps" label="Kick Speed (m/s)" format="N0" tooltip="Vertical speed the rocket needs to reach during the initial straight-up rise before it performs its pitch kick" />
                    <K2UI.K2Slider label-on-top="true" print-value="true" min="1" value="7.5" max="25" name="gravity_turn_pitch_kick_deg" label="Pitch Kick (°)" format="N1" tooltip="Tilt after the vertical rise, held until the velocity follows - prograde straight up has nothing to fall over from, so the turn needs this seed" />
                    <K2UI.K2Slider label-on-top="true" print-value="true" min="25" value="45" max="120" name="gravity_turn_hold_time_s" label="Hold Time to Apoapsis (s)" format="N0" tooltip="Seconds to apoapsis the throttle holds during the turn. Lower makes a flatter climb (usually cheaper, but more time in thick air), higher a steeper one" />
                    <K2UI.K2Slider label-on-top="true" print-value="true" min="0" value="0.25" max="0.5" name="gravity_turn_min_throttle" label="Min Throttle (%)" format="percent" tooltip="Throttle never goes below this during the turn. Near the end it keeps the rocket raising its apoapsis instead of levelling off in the air" />
                    <K2UI.K2Slider label-on-top="true" print-value="true" min="1.2" value="2.5" max="5" name="gravity_turn_max_twr" label="Max TWR" format="N1" tooltip="The throttle is held down so thrust never exceeds this many times the rocket's weight - keeps powerful rockets from climbing too steeply and fast through thick air" />
                    <K2UI.K2Slider label-on-top="true" print-value="true" min="10" value="40" max="100" name="gravity_turn_max_q_kpa" label="Max Dynamic Pressure (kPa)" format="N0" tooltip="The throttle eases off as the air pressure on the rocket nears this, to limit drag and aerodynamic stress" />
                </ui:VisualElement>
                <ui:VisualElement name="heading_row" class="k2-slider-label-row">
                    <ui:Label text="Heading" />
                    <ui:Label tabindex="-1" text="30°" display-tooltip-when-elided="true" name="heading_label" class="k2-slider-value-label" />
                </ui:VisualElement>
                <K2UI.K2Compass name="heading" />
                <ui:VisualElement name="graph" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); height: 162px; border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: rgb(71, 75, 175); border-right-color: rgb(71, 75, 175); border-top-color: rgb(71, 75, 175); border-bottom-color: rgb(71, 75, 175); border-top-left-radius: 5px; border-bottom-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px;" />
            </ui:Foldout>
            <K2UI.K2Slider name="max_throttle" tooltip="Throttle limit for the whole ascent" label="Max Throttle (%)" format="percent" max="1" print-value="true" label-on-top="true" value="1" min="0.05" />
            <K2UI.ToggleButton name="run" label="Start" class="big" style="margin-top: 10px; margin-bottom: 10px;" />
            <ui:VisualElement name="status_progress_group" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); margin-top: 10px; margin-bottom: 12px;">
                <ui:VisualElement name="k2_status_row" class="k2-status-row">
                    <K2UI.K2Avatar name="k2_avatar" />
                    <ui:VisualElement name="k2_status_speech" class="k2-status-speech">
                        <K2UI.StatusLine tabindex="-1" text="Status Pilot" name="status_pilot" />
                        <K2UI.Console tabindex="-1" name="pilot_console" text="Console Pilot" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <K2UI.K2ProgressBar name="progress" set-label-to-value="false" value="70.27" max="100" label=" " postfix=" %" style="height: 25px;" />
            </ui:VisualElement>
            <ui:Foldout text="LIFT INFO" value="false" name="lift_info_foldout">
                <ui:VisualElement name="lift_infos" class="advanced-info-table" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0);" />
            </ui:Foldout>
            <ui:Foldout text="ADVANCED" value="false" name="advanced_foldout">
                <ui:VisualElement name="Ascent">
                    <ui:Label text="// ASCENT" class="k2-section-header" />
                    <K2UI.K2Toggle label="Heading Correction" name="heading_correction" tooltip="Steer so the velocity stays on the chosen heading" />
                    <K2UI.K2Slider label="Ap Alt Error (%)" name="end_ascent_pc" tooltip="The ascent burn stops once apoapsis is this close to the target" format="N2" print-value="true" label-on-top="true" />
                    <ui:Label tabindex="-1" text="End Ascent Alt. : " display-tooltip-when-elided="true" name="end_ascent_alt" />
                </ui:VisualElement>
                <ui:VisualElement name="Coasting">
                    <ui:Label text="// COASTING" class="k2-section-header" />
                    <K2UI.K2Toggle label="Coasting Warp" name="coasting_warp" tooltip="Time warp while coasting up to the edge of the atmosphere" />
                    <K2UI.K2Toggle label="Circularize Once Ascent Complete" name="auto_circularize" class="long-label" tooltip="Finish the ascent with a circularization burn at apoapsis. Off: the ascent ends once apoapsis is set, and you circularize yourself" />
                    <K2UI.K2Toggle label="Pause Leaving Atmosphere" name="pause_on_final" tooltip="When Circularize Once Ascent Complete is off: pause the game once the vessel is out of the atmosphere and apoapsis is set, so you can plan your circularization" />
                </ui:VisualElement>
                <ui:VisualElement name="Adjust">
                    <ui:Label text="// ADJUST" class="k2-section-header" />
                    <K2UI.K2Toggle label="Fine Tuning" name="adjust" tooltip="Once out of the atmosphere, burn prograde to bring apoapsis back up to the target (drag lowers it on the way up)" />
                    <ui:VisualElement name="adjust_group" class="k2-nested-content">
                        <K2UI.K2Slider label="Final Alt Error (%)" name="end_adjust_pc" tooltip="Fine tuning stops once apoapsis is this close to the target" format="N3" print-value="true" label-on-top="true" />
                        <ui:Label tabindex="-1" text="End Adjust Alt : " display-tooltip-when-elided="true" name="end_adjust_alt" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:Foldout>
        </ui:VisualElement>
        <ui:VisualElement name="settings" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); display: none;">
            <ui:Label tabindex="-1" text="Lift Settings" display-tooltip-when-elided="true" name="Title" class="k2-title" />
        </ui:VisualElement>
    </K2UI.Tabs.TabPage>
</ui:UXML>
