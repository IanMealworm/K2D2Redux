<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/K2D2_UI/K2D2.uss?fileID=7433441132597879392&amp;guid=f49119c0dc6aec7469a0374f7f606ceb&amp;type=3#K2D2" />
    <Style src="project://database/Assets/Runtime/K2UI/USS/K2UI.uss?fileID=7433441132597879392&amp;guid=d70a8288b6b3eee4a900aa2727eb7499&amp;type=3#K2UI" />
    <Style src="project://database/Assets/Runtime/K2UI/USS/ToggleButton.uss?fileID=7433441132597879392&amp;guid=1b6a73cd9e0a617469e5d501d696c7be&amp;type=3#ToggleButton" />
    <Style src="project://database/Assets/Runtime/K2UI/USS/K2Toggle.uss?fileID=7433441132597879392&amp;guid=a6dc5024ba8ad204e9099eca78c0703f&amp;type=3#K2Toggle" />
    <Style src="project://database/Assets/Runtime/K2UI/USS/K2Slider.uss?fileID=7433441132597879392&amp;guid=3d8e4d9f1386ac94c97e6381ad01c59b&amp;type=3#K2Slider" />
    <K2UI.Tabs.TabPage name="lift" label="Lift" style="display: flex;">
        <ui:VisualElement name="page" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); display: flex;">
            <ui:Label tabindex="-1" text="Ascent Autopilot" display-tooltip-when-elided="true" name="Title" class="unselectedContent" style="display: flex; width: 100%; -unity-text-align: upper-center;" />
            <ui:Foldout text="Profile" value="false" name="profile">
                <ui:IntegerField label="Ap Altitude" value="42" name="destination_Ap_km" style="justify-content: space-between;">
                    <ui:Label tabindex="-1" text="km" display-tooltip-when-elided="true" style="width: 28px; min-width: 10px; margin-right: 0; margin-left: 10px;" />
                </ui:IntegerField>
                <!-- Reverted back to sliders (typed absolute-km fields didn't stick) - title
                     stays static now ("5° Alt"/"45° Alt", never rewritten), the live computed
                     altitude reads in the amber value slot via K2Slider's new ValueText override
                     (see K2Slider.cs) instead of being baked into one plain-white title string,
                     matching the amber "cockpit gauge" value convention used elsewhere. -->
                <K2UI.K2Slider name="end_rotate_ratio" label="5° Alt" max="10" print-value="false" label-on-top="true" value="0" min="0.01" />
                <K2UI.K2Slider name="mid_rotate_ratio" label="45° Alt" max="10" print-value="false" label-on-top="true" value="0.98" min="0.01" />
                <ui:IntegerField label="90° Alt. :" value="42" name="start_altitude_km" style="justify-content: space-between;">
                    <ui:Label tabindex="-1" text="km" display-tooltip-when-elided="true" style="width: 28px; min-width: 10px; margin-right: 0; margin-left: 10px;" />
                </ui:IntegerField>
                <!-- Same title-left/amber-value-right treatment as the sliders above, reusing
                     K2Slider's own label_row/value_label CSS classes directly since this isn't a
                     K2Slider itself. -->
                <ui:VisualElement name="heading_row" class="k2-slider-label-row">
                    <ui:Label text="Heading" style="font-size: 13px;" />
                    <ui:Label tabindex="-1" text="30°" display-tooltip-when-elided="true" name="heading_label" class="k2-slider-value-label" style="font-size: 13px;" />
                </ui:VisualElement>
                <K2UI.K2Compass name="heading" />
                <ui:VisualElement name="graph" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); height: 162px; border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: rgb(71, 75, 175); border-right-color: rgb(71, 75, 175); border-top-color: rgb(71, 75, 175); border-bottom-color: rgb(71, 75, 175); border-top-left-radius: 5px; border-bottom-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px;" />
            </ui:Foldout>
            <K2UI.K2Slider name="max_throttle" label="Max Throttle" max="10" print-value="false" label-on-top="false" value="0" min="0.01" />
            <K2UI.ToggleButton name="run" label="Start" class="big" style="flex-grow: 1; margin-top: 10px; margin-bottom: 10px;" />

            <!-- K2 arrives on the Lift tab: same merged "K2 is talking" element as the Node tab
                 (yellow status line + console read together, next to K2's animated icon) instead
                 of the shared StatusGroup template's plain status_pilot/pilot_console pair. -->
            <ui:VisualElement name="status_progress_group" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); margin-top: 10px; margin-bottom: 12px;">
                <ui:VisualElement name="k2_status_row" class="k2-status-row">
                    <K2UI.K2Avatar name="k2_avatar" />
                    <ui:VisualElement name="k2_status_speech" class="k2-status-speech">
                        <K2UI.StatusLine tabindex="-1" text="Status Pilot" name="status_pilot" />
                        <K2UI.Console tabindex="-1" name="pilot_console" text="Console Pilot" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <K2UI.K2ProgressBar name="progress" set-label-to-value="false" value="70.27" max="100" label=" " postfix=" %" style="height: 25px;" />
            </ui:VisualElement>
            <ui:VisualElement name="final_grp" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); flex-direction: column; flex-wrap: wrap; align-self: auto; justify-content: space-between;">
                <ui:VisualElement style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); flex-direction: row; justify-content: flex-start;">
                    <ui:Button text="Create Node at AP" display-tooltip-when-elided="true" name="create_ap" style="flex-grow: 1; height: 28px;" />
                    <ui:Button text="Create Node Now" display-tooltip-when-elided="true" name="create_now" style="flex-grow: 1; height: 28px;" />
                </ui:VisualElement>
                <ui:Button text="Run" display-tooltip-when-elided="true" name="run" style="flex-grow: 1; font-size: 16px; height: 30px; max-width: 184px; align-self: center; width: 121px; margin-top: 9px;" />
            </ui:VisualElement>

            <!-- Same treatment as the Node tab: a live LIFT INFO readout split into its own
                 dropdown (built into label/value table rows from C# - see LiftUI.cs's
                 AddInfoRow/UpdateLiftInfos, same pattern as NodeExUI's node_infos) so the numeric
                 telemetry that used to scroll through the console text doesn't bury the ascent
                 phase's own narrative feedback (e.g. "Coasting", TurnTo's status_line) that still
                 goes through the merged K2 status readout above. -->
            <ui:Foldout text="LIFT INFO" value="false" name="lift_info_foldout">
                <ui:VisualElement name="lift_infos" class="advanced-info-table" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0);" />
            </ui:Foldout>

            <!-- Same treatment as the Node tab: the old separate "settings" page (shown only via
                 the global settings-gear toggle) is redundant now that everything it held fits in
                 one inline dropdown here on "page" - collapsed by default so it doesn't compete
                 with the main Ascent controls above. "settings" below is kept only because
                 K2Page.Init()'s Q<VisualElement>("settings") lookup expects to find it, but it no
                 longer carries any real controls - the Reset button now lives at the bottom of
                 this ADVANCED foldout instead (see LiftUI.cs's addResetButton call).

                 Sections below now mirror LiftPilot's own sub-pilot phases (Ascent/Coasting/
                 Adjust/FinalCircularize) with "// SECTION" header bars, same convention as the
                 Node tab's Turn/Warp/Burn/Experimental split - one scrollable dropdown, not a
                 Foldout-in-a-Foldout per group. -->
            <ui:Foldout text="ADVANCED" value="false" name="advanced_foldout">
                <ui:VisualElement name="Ascent">
                    <ui:Label text="// ASCENT" class="k2-section-header" />
                    <K2UI.K2Toggle label="Heading Correction" name="heading_correction" tooltip="Correct the Speed direction to fit wanted heading" />
                    <K2UI.K2Slider label="Ap Alt Error (%)" name="end_ascent_pc" print-value="true" label-on-top="true" />
                    <ui:Label tabindex="-1" text="End Ascent Alt. : " display-tooltip-when-elided="true" name="end_ascent_alt" />
                </ui:VisualElement>
                <ui:VisualElement name="Coasting">
                    <ui:Label text="// COASTING" class="k2-section-header" />
                    <K2UI.K2Toggle label="Coasting Warp" name="coasting_warp" tooltip="Auto Warp while waiting for leaving Atm." />
                </ui:VisualElement>
                <ui:VisualElement name="Adjust">
                    <ui:Label text="// ADJUST" class="k2-section-header" />
                    <K2UI.K2Toggle label="Fine Tuning" name="adjust" tooltip="Auto Warp while waiting for leaving Atm." />
                    <K2UI.Group name="adjust_group" text="tuning">
                        <K2UI.K2Slider label="Final Alt Error (%)" name="end_adjust_pc" print-value="true" label-on-top="true" />
                        <ui:Label tabindex="-1" text="End Adjust Alt : " display-tooltip-when-elided="true" name="end_adjust_alt" />
                    </K2UI.Group>
                </ui:VisualElement>
                <ui:VisualElement name="Final">
                    <ui:Label text="// FINAL" class="k2-section-header" />
                    <K2UI.K2Toggle label="Pause on Final" name="pause_on_final" tooltip="Pause when creating final node" />
                </ui:VisualElement>
            </ui:Foldout>
        </ui:VisualElement>
        <ui:VisualElement name="settings" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); display: none;">
            <ui:Label tabindex="-1" text="Lift Settings" display-tooltip-when-elided="true" name="Title" class="unselectedContent" style="display: flex;" />
        </ui:VisualElement>
    </K2UI.Tabs.TabPage>
</ui:UXML>
