<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <K2UI.Tabs.TabPage name="node" label="Node" style="display: flex;">
        <ui:VisualElement name="page" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); display: flex;">
            <ui:Label tabindex="-1" text="Maneuver Node Autopilot" display-tooltip-when-elided="true" name="Title" class="k2-title" />
            <ui:VisualElement name="circularize_bars" class="k2-button-row" style="margin-top: 0; margin-bottom: 8px;">
                <ui:Button text="Circularize at AP" display-tooltip-when-elided="true" name="circularize_ap" class="k2-button k2-button--small" tooltip="Add a node at the next apoapsis that raises periapsis to match it" />
                <ui:Button text="Circularize at PE" display-tooltip-when-elided="true" name="circularize_pe" class="k2-button k2-button--small" tooltip="Add a node at the next periapsis that lowers apoapsis to match it" />
            </ui:VisualElement>
            <ui:VisualElement name="button_bars" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); flex-direction: row;">
                <K2UI.ToggleButton name="run" label="Start" class="big" style="flex-grow: 1;" />
                <K2UI.ToggleButton name="pause" class="big icon yellow" style="margin-left: 4px;">
                    <ui:VisualElement name="icon" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); background-image: url(&apos;project://database/Assets/Images/pause.png?fileID=2800000&amp;guid=02fa898692f9898449b2e0582c422977&amp;type=3#pause&apos;); -unity-background-scale-mode: scale-to-fit;" />
                </K2UI.ToggleButton>
            </ui:VisualElement>
            <ui:VisualElement name="status_progress_group" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); margin-top: 10px; margin-bottom: 12px;">
                <ui:VisualElement name="k2_status_row" class="k2-status-row">
                    <K2UI.K2Avatar name="k2_avatar" />
                    <ui:VisualElement name="k2_status_speech" class="k2-status-speech">
                        <K2UI.StatusLine tabindex="-1" text="Status Pilot" name="status_pilot" />
                        <K2UI.Console tabindex="-1" name="pilot_console" text="Console Pilot" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <K2UI.K2ProgressBar name="progress" set-label-to-value="false" value="70.27" max="100" label=" " postfix=" %" style="height: 25px;" />
            </ui:VisualElement>

            <ui:Foldout text="NODE INFO" value="false" name="node_info_foldout">
                <ui:VisualElement name="node_infos" class="advanced-info-table" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0);" />
            </ui:Foldout>
            <ui:Foldout text="ADVANCED" value="false" name="advanced_info_foldout">
                <ui:VisualElement name="Turn">
                    <ui:Label text="// TURN" class="k2-section-header" />
                    <K2UI.K2Slider name="max_angle_maneuver" tooltip="How closely the vessel must point along the burn before it starts" label="Max Angle (°)" format="N1" max="10" print-value="true" label-on-top="true" value="0.01" min="0.01" />
                    <K2UI.K2Slider name="max_angular_speed" tooltip="How still the vessel must be before the burn starts" label="Max Angular Speed" format="N2" max="10" print-value="true" label-on-top="true" value="0.98" min="0.01" />
                </ui:VisualElement>
                <ui:VisualElement name="Warp">
                    <ui:Label text="// WARP" class="k2-section-header" />
                    <K2UI.K2Toggle label="Auto Warp" name="auto_warp" tooltip="Warp time before burn" />
                    <ui:VisualElement name="warp_settings" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0);">
                        <K2UI.K2Slider label-on-top="true" min-max-label="Safe-Quick" print-value="true" min="0" value="1" max="7" name="warp_speed" tooltip="How hard time warp pushes toward the burn" label="Warp Speed" format="N1" />
                        <ui:IntegerField label="Before Burn (s)" value="42" is-delayed="true" name="warp_safe_duration" tooltip="Seconds at normal speed before the burn (at least 5)" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="Burn">
                    <ui:Label text="// BURN" class="k2-section-header" />
                    <K2UI.K2Slider label-on-top="true" min-max-label="Precise-Quick" print-value="true" min="0.5" value="0.5" max="2" name="burn_adjust" tooltip="How the throttle eases off for the last bit of the burn: lower is more precise, higher is quicker" label="Adjusting Rate (m/s)" format="N1" />
                    <K2UI.K2Slider label-on-top="true" print-value="true" min="0.001" value="0.08" max="0.1" name="max_dv_error" tooltip="The burn ends once less than this much Δv is left" label="Precision (m/s)" format="N3" />
                </ui:VisualElement>
                <ui:VisualElement name="Experimental">
                    <ui:Label text="// EXPERIMENTAL" class="k2-section-header" />
                    <K2UI.K2Toggle label="T0" name="start_mode_precise" tooltip="Start the burn at the node time" />
                    <K2UI.K2Toggle label="Before" name="start_mode_constant" tooltip="Start the burn a set time before the node" />
                    <ui:VisualElement name="start_mode_constant_content" class="k2-nested-content" style="display: none;">
                        <K2UI.K2Slider label-on-top="true" print-value="true" min="0" value="1" max="10" name="start_before" tooltip="How many seconds before the node the burn starts" label="Start Before T0 (s)" format="N1" />
                    </ui:VisualElement>
                    <K2UI.K2Toggle label="Mid-duration" name="start_mode_half_duration" tooltip="Center the burn on the node: start half the burn time early" />
                    <K2UI.K2Toggle label="Rotate During Burn" tooltip="Keep pointing along the maneuver for the whole burn" name="rotate_during_burn" />
                </ui:VisualElement>
            </ui:Foldout>
        </ui:VisualElement>
        <ui:VisualElement name="settings" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); display: none;">
            <ui:Label tabindex="-1" text="Node Auto-Executor Settings" display-tooltip-when-elided="true" name="Title" class="k2-title" />
        </ui:VisualElement>
    </K2UI.Tabs.TabPage>
</ui:UXML>
