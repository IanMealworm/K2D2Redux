/* Tab bar: a plain row of names splitting the width evenly, dim when unselected, bright and bold
   with a short green underline when selected. */

.k2-tabsbar {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-start;
    align-items: stretch;
    border-color: rgba(60, 62, 146, 0.35);
    border-bottom-width: 1px;
}

.k2-tab-button {
    height: 30px;
    min-width: 50px;
    flex-grow: 1;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
    margin: 0;
    padding: 0 4px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
}

.k2-tab-button:hover {
    background-color: rgba(255, 255, 255, 0.04);
}

.k2-tab-button:active {
    background-color: rgba(255, 255, 255, 0.07);
}

.k2-tab-button > Label {
    width: 100%;
    min-width: 10px;
    color: rgb(120, 128, 145);
    font-size: var(--k2-size-button);
    -unity-font-style: normal;
    -unity-text-align: middle-center;
    letter-spacing: 1px;
}

/* The underline is a tinted image (an 8x8 white square) rather than a border, since a border
   always spans the whole button. */
.k2-tab-button.k2-tab-button--active {
    background-image: url('project://database/Assets/Images/tab_underline.png?fileID=2800000&guid=8fe0d00951b4482e921b0a7d1cd22b4a&type=3#tab_underline');
    -unity-background-image-tint-color: var(--k2-color-accent);
    background-repeat: no-repeat;
    background-position: center bottom;
    background-size: 22px 2px;
}

.k2-tab-button.k2-tab-button--active > Label {
    color: var(--k2-color-text-bright);
    -unity-font-style: bold;
}

/* The old per-tab "running" light: only one pilot runs at a time, so it's not shown. */
.k2-tab-button #tab_light {
    display: none;
}

TabPage {
    margin-top: 5px;
}
