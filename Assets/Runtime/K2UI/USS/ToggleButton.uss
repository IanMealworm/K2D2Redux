/* K2UI.ToggleButton: an on/off button (see ToggleButton.cs), in the game's button look (see
   .k2-button in K2UI.uss). The small version is used for rows of options (InlineEnum, Dock's
   kill-speed axes); .big is the main Start/Stop/Brake and Debug Mode. On is the game's green. */

.toggle-button {
    border-width: 1px;
    border-color: var(--k2-button-outline);
    background-color: var(--k2-button-face);
    border-radius: 6px;
    margin: 2px 2px 4px 2px;
    transition-property: background-color, border-color;
    transition-duration: 0.3s;
}

.toggle-button:hover {
    background-color: var(--k2-button-hover);
}

.toggle-button:active {
    background-color: var(--k2-button-pressed);
}

.toggle-button > Label {
    color: var(--k2-color-button-text);
    font-size: var(--k2-size-label);
    -unity-text-align: middle-center;
}

.toggle-button.checked {
    background-color: var(--k2-button-on-face);
    border-color: var(--k2-button-on-outline);
}

.toggle-button.checked:hover {
    background-color: var(--k2-button-on-hover);
}

.toggle-button #icon {
    -unity-background-image-tint-color: var(--k2-color-button-text);
}

.toggle-button.yellow.checked {
    background-color: rgb(120, 100, 20);
    border-color: rgb(255, 214, 51);
}

/* ===== Big button ===== */

.toggle-button.big {
    height: 30px;
    margin: 0;
    justify-content: center;
    border-radius: 8px;
}

.toggle-button.big > Label {
    font-size: var(--k2-size-button);
    -unity-font-style: normal;
}

/* Square icon-only version (Node's Pause). */
.toggle-button.big.icon {
    width: 30px;
    flex-shrink: 0;
    padding: 4px;
}

.toggle-button.big.icon Label {
    display: none;
}

/* ===== Option rows ===== */

.inline_enum {
    flex-direction: row;
    justify-content: center;
    flex-wrap: wrap;
    overflow: hidden;
}

.inline_enum .toggle-button {
    flex-grow: 1;
    height: 25px;
    justify-content: center;
}
