/* Shared look for every K2D2 control. Loaded once by K2D2_Window.uxml, after the game's
   KerbalUI.uss and before K2D2.uss - the tab templates don't load stylesheets of their own, so
   this order holds on every tab. */

:root {
    /* One font for everything; titles and headers set it bold. --k2-font-display is kept
       separate so a different title font can be tried by changing this one line. */
    --k2-font-body: url('project://database/Packages/uitkforksp2.controls/Assets/Theme/Fonts/JetBrainsMono/JetBrainsMono-Regular%20SDF.asset?fileID=11400000&guid=f5454c9c675002c44a5a7234bd40c390&type=2#JetBrainsMono-Regular SDF');
    --k2-font-display: url('project://database/Packages/uitkforksp2.controls/Assets/Theme/Fonts/JetBrainsMono/JetBrainsMono-Regular%20SDF.asset?fileID=11400000&guid=f5454c9c675002c44a5a7234bd40c390&type=2#JetBrainsMono-Regular SDF');

    /* Size scale. */
    --k2-size-title: 15px;
    --k2-size-button: 14px;
    --k2-size-label: 13px;
    --k2-size-info: 12px;
    --k2-size-small: 11px;

    /* Text. */
    --k2-color-text: rgb(192, 199, 213);
    --k2-color-text-dim: rgb(140, 148, 163);
    --k2-color-text-bright: rgb(230, 233, 238);
    --k2-color-value: rgb(242, 201, 76);
    --k2-color-header: rgb(180, 176, 232);
    --k2-color-warning: rgb(255, 202, 0);
    --k2-color-error: rgb(232, 96, 96);
    --k2-color-note: rgb(224, 132, 132);

    /* Accent: everything that means "on" or "running". */
    --k2-color-accent: rgb(0, 204, 83);

    /* Surfaces and frames. */
    --k2-color-background: rgb(0, 0, 0);
    --k2-color-header-bar: rgb(35, 40, 52);
    --k2-color-header-bar-hover: rgb(45, 51, 66);
    --k2-color-separator: rgba(87, 95, 111, 0.25);
    --k2-color-border: rgb(76, 80, 188);
    --k2-color-border-bottom: rgb(90, 94, 211);
    --k2-color-button-text: rgb(242, 242, 242);
    --k2-hover_frame: rgb(16, 16, 37);
    --k2-active_frame: rgb(30, 32, 77);
    --k2-background-frame: rgba(76, 79, 188, 0.1);
    --k2-color-textfield-border-focus: rgb(170, 178, 255);
    --k2-color-invalid: rgb(200, 40, 40);

    /* Buttons, taken from the game's own (KerbalUI's .unity-button): a near-black face with a
       faint white outline, blue when hovered or pressed. Running buttons use the game's green
       toggle colours. */
    --k2-button-face: rgb(15, 19, 24);
    --k2-button-outline: rgba(255, 255, 255, 0.2);
    --k2-button-hover: rgb(65, 84, 131);
    --k2-button-pressed: rgb(101, 128, 199);
    --k2-button-on-face: rgb(34, 102, 56);
    --k2-button-on-hover: rgb(46, 130, 72);
    --k2-button-on-outline: rgb(91, 255, 168);

    -unity-font-definition: var(--k2-font-body);
    font-size: var(--k2-size-label);
    color: var(--k2-color-text);
}

/* Every piece of text - labels, button text, field text, dropdown text. */
.unity-text-element {
    -unity-font-definition: var(--k2-font-body);
}

Label {
    min-width: 50px;
    -unity-text-align: upper-left;
    color: var(--k2-color-text);
}

/* ===== Page title and headers ===== */

.k2-title {
    -unity-font-definition: var(--k2-font-display);
    font-size: var(--k2-size-title);
    color: var(--k2-color-text-bright);
    -unity-font-style: bold;
    letter-spacing: 1px;
    -unity-text-align: upper-center;
    width: 100%;
    margin-bottom: 6px;
}

/* A collapsible dropdown: a header bar flush in the list, no box around the content. */
.unity-foldout {
    margin-left: 4px;
    margin-right: 4px;
    margin-top: 0;
    margin-bottom: 6px;
    border-width: 0;
    background-color: var(--k2-color-background);
}

/* Matches KerbalUI's own two-class selector so this wins on order rather than losing on
   specificity to its rounded, margined header. */
.unity-foldout > .unity-foldout__toggle {
    background-color: var(--k2-color-header-bar);
    margin: 0;
    padding: 1px 0 1px 2px;
    border-radius: 0;
}

.unity-foldout > .unity-foldout__toggle:hover {
    background-color: var(--k2-color-header-bar-hover);
}

.unity-foldout > .unity-foldout__toggle Label {
    -unity-font-definition: var(--k2-font-display);
    font-size: var(--k2-size-label);
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: var(--k2-color-header);
}

/* A non-collapsible divider inside a dropdown ("// WARP"). Same bar as a dropdown header; the
   "//" in the text is what tells the two apart. */
.k2-section-header {
    -unity-font-definition: var(--k2-font-display);
    background-color: var(--k2-color-header-bar);
    color: var(--k2-color-header);
    font-size: var(--k2-size-label);
    -unity-font-style: bold;
    letter-spacing: 1px;
    padding: 3px 6px;
    margin-top: 8px;
    margin-bottom: 4px;
}

/* Controls revealed under a toggle, indented with a thin rule to show what they belong to. */
.k2-nested-content {
    margin-left: 12px;
    margin-top: 2px;
    margin-bottom: 4px;
    padding-left: 8px;
    border-left-width: 1px;
    border-left-color: rgba(87, 95, 111, 0.4);
}

/* A short explanation shown under a control when it can't be used right now. */
.k2-note {
    color: var(--k2-color-note);
    font-size: var(--k2-size-info);
    white-space: normal;
    margin-top: 2px;
    margin-bottom: 4px;
}

/* Explanatory text under a section. */
.k2-help {
    color: var(--k2-color-text-dim);
    font-size: var(--k2-size-info);
    white-space: normal;
}

.separator {
    border-color: var(--k2-color-border);
    border-top-width: 2px;
}

/* ===== Buttons ===== */

/* Plain buttons keep the game's own look (KerbalUI's .unity-button.unity-text-element); this
   only spaces them out. */
.unity-button {
    margin: 2px;
    padding: 0 6px;
}

/* Action buttons: the game's button look, restated so it also covers RepeatButtons (which
   aren't .unity-button). Two classes so it outranks KerbalUI's rules whatever loads first. */
.unity-button.k2-button,
.k2-button {
    height: 30px;
    margin: 0;
    padding: 0 6px;
    border-width: 1px;
    border-radius: 8px;
    border-color: var(--k2-button-outline);
    background-color: var(--k2-button-face);
    background-image: none;
    color: var(--k2-color-button-text);
    font-size: var(--k2-size-button);
    -unity-font-style: normal;
    -unity-text-align: middle-center;
    transition-property: background-color, border-color;
    transition-duration: 0.3s;
}

.unity-button.k2-button:hover,
.k2-button:hover {
    background-color: var(--k2-button-hover);
}

.unity-button.k2-button:active,
.k2-button:active {
    background-color: var(--k2-button-pressed);
}

/* Secondary actions (Node's circularize buttons). */
.unity-button.k2-button.k2-button--small {
    height: 24px;
    border-radius: 6px;
    font-size: var(--k2-size-small);
}

/* Square stepper buttons (Attitude's elevation - and +). */
.unity-button.k2-button.k2-button--square,
.k2-button.k2-button--square {
    width: 26px;
    height: 24px;
    padding: 0;
    border-radius: 6px;
    -unity-font-style: bold;
}

/* A row of equal-width buttons. The extra selectors outrank the buttons' own margin: 0 (here and
   in ToggleButton.uss), which otherwise left the buttons touching. */
.k2-button-row {
    flex-direction: row;
    margin-top: 10px;
    margin-bottom: 10px;
}

.k2-button-row > *,
.k2-button-row > .unity-button.k2-button,
.k2-button-row > .toggle-button.big {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 3px;
}

/* A column of full-width buttons. */
.k2-button-column > *,
.k2-button-column > .unity-button.k2-button,
.k2-button-column > .toggle-button.big {
    margin: 6px 0 0 0;
}

/* ===== Fields ===== */

.unity-base-field__label {
    font-size: var(--k2-size-label);
    color: var(--k2-color-text);
}

.unity-base-field:focus > .unity-base-field__label {
    color: var(--k2-color-text-bright);
}

#unity-text-input {
    padding: 0;
    background-color: rgba(0, 0, 0, 0.76);
    border-color: var(--k2-color-border);
    border-radius: 2px;
    max-width: 100px;
    --unity-cursor-color: var(--k2-color-border);
}

#unity-text-input > TextElement {
    margin-left: 5px;
    margin-top: 0;
}

/* The input box is styled by its id above (and in the game theme), so the focus rule needs the
   id too to outrank it. */
.unity-base-text-field:focus #unity-text-input,
#unity-text-input:focus {
    border-color: var(--k2-color-textfield-border-focus);
    background-color: rgba(30, 34, 70, 0.9);
}

.unity-text-field-invalid #unity-text-input,
.unity-text-field-invalid:focus #unity-text-input {
    color: var(--k2-color-invalid);
    border-color: var(--k2-color-invalid);
}

/* ===== Dropdowns ===== */

/* The label takes what it needs and the box fills the rest of the row, so a dropdown never runs
   past the window's edge. */
.unity-popup-field {
    flex-grow: 0;
    height: 24px;
}

.unity-popup-field__label {
    min-width: 0;
    width: auto;
    flex-shrink: 0;
    margin-right: 8px;
}

.unity-popup-field__input {
    flex-grow: 1;
    flex-shrink: 1;
    width: auto;
    min-width: 80px;
    height: 24px;
    padding: 1px;
    border-radius: 8px;
    border-width: 1px;
    border-color: var(--k2-color-border);
    border-bottom-color: var(--k2-color-border-bottom);
    background-color: var(--k2-color-background);
}

.unity-popup-field:focus {
    color: var(--k2-color-text-bright);
}

.unity-base-popup-field__text {
    font-size: var(--k2-size-info);
    margin: 0 4px 0 0;
    color: var(--k2-color-text-bright);
    overflow: hidden;
    text-overflow: ellipsis;
}

.unity-base-dropdown__item:hover {
    background-color: rgba(255, 255, 0, 0.2);
    border-radius: 3px;
}

.unity-base-dropdown__arrow {
    display: none;
}

/* ===== K2's status readout ===== */

.k2-status-row {
    flex-direction: row;
    align-items: center;
    padding-left: 6px;
}

.k2-status-speech {
    flex-direction: column;
    flex-grow: 1;
}

.k2-status-line {
    font-size: var(--k2-size-button);
    white-space: normal;
}

.k2-status-line--normal {
    color: var(--k2-color-text-bright);
}

.k2-status-line--warning {
    color: var(--k2-color-warning);
}

.k2-status-line--error {
    color: var(--k2-color-error);
}

.console {
    font-size: var(--k2-size-label);
    color: var(--k2-color-text);
    white-space: normal;
    margin-top: 5px;
    margin-bottom: 5px;
}

.k2-status-speech > .console {
    margin-top: 0;
}

.k2-status-speech > .k2-status-line {
    margin-bottom: 0;
}

/* K2's face, with the three grille lines from the artwork lit in turn while a pilot runs (see
   K2Avatar.cs). Positions are measured off the icon at this size. */
.k2-avatar {
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    margin-right: 16px;
}

.k2-avatar-icon {
    width: 100%;
    height: 100%;
    background-image: url('project://database/Assets/Images/k2d2_big_icon.png?fileID=2800000&guid=8ef988e0f43beb149a76620d7ba3ed65&type=3#k2d2_big_icon');
    -unity-background-scale-mode: scale-to-fit;
    position: relative;
}

.k2-avatar-light {
    position: absolute;
    left: 12px;
    width: 8px;
    height: 2px;
    background-color: rgba(0, 0, 0, 0);
    border-radius: 1px;
    transition-property: background-color;
    transition-duration: 0.15s;
}

.k2-avatar-light-0 { top: 41px; }
.k2-avatar-light-1 { top: 43px; }
.k2-avatar-light-2 { top: 45px; }

.k2-avatar-light--on {
    background-color: rgb(90, 190, 255);
}

/* ===== Progress bar ===== */

.k2-progress-bar {
    min-height: 16px;
    margin-top: 4px;
    margin-bottom: 4px;
}

.k2-progress-bar #frame {
    width: 100%;
    height: 100%;
    flex-grow: 1;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
    background-color: rgb(41, 47, 57);
    border-width: 2px;
    border-top-color: rgb(110, 118, 135);
    border-left-color: rgb(110, 118, 135);
    border-bottom-color: rgb(20, 22, 28);
    border-right-color: rgb(20, 22, 28);
    border-radius: 8px;
}

.k2-progress-bar #progress {
    width: 439px;
    position: absolute;
    height: 100%;
    min-width: initial;
    min-height: initial;
    border-width: 0;
    border-radius: 0 5px 5px 0;
    background-color: var(--k2-color-accent);
    background-image: url('project://database/Assets/Images/progress_stripes.png?fileID=2800000&guid=1c50209de9094733b71cf44a7f1f5b18&type=3#progress_stripes');
    background-repeat: repeat;
    background-size: 16px 16px;
}

.k2-progress-bar #label {
    position: absolute;
    width: 100%;
    color: rgb(255, 255, 255);
    font-size: var(--k2-size-info);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    text-shadow: 0 0 1px rgb(0, 0, 0);
    letter-spacing: 0;
}

/* ===== Info tables (Node Info, Lift Info, Landing Info, Dock's context) ===== */

.advanced-info-table {
    margin-top: 4px;
}

.advanced-info-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-top: 3px;
    padding-bottom: 3px;
    border-bottom-width: 1px;
    border-bottom-color: var(--k2-color-separator);
}

.advanced-info-row-label {
    color: var(--k2-color-text-dim);
    font-size: var(--k2-size-info);
}

.advanced-info-row-value {
    color: var(--k2-color-text-bright);
    -unity-font-style: bold;
    font-size: var(--k2-size-info);
}
