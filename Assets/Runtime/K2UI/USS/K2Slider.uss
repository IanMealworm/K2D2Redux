/* K2UI.K2Slider: a title on the left and its value (amber, like the game's gauges) on the right,
   over the game's own slider (KerbalUI's .unity-base-slider): a thin blue dashed track and a
   pale blue handle in a rounded frame. */

.k2-slider {
    flex-direction: row;
    flex-grow: 1;
}

.k2-slider > VisualElement {
    background-color: rgba(0, 0, 0, 0);
    height: 26px;
    border-color: rgb(255, 255, 255);
    border-width: 0;
    border-radius: 3px;
    align-self: auto;
    justify-content: flex-start;
    flex-direction: column;
    flex-grow: 1;
}

/* With the label beside the track instead of above it, the label row sits inside the slider's
   own row - this keeps it from taking half the width. */
.k2-slider > #label_row {
    flex-grow: 0;
    flex-shrink: 0;
}

.k2-slider #unity-drag-container {
    overflow: hidden;
    margin-left: 0;
}

/* The dashed track is drawn by K2Slider.cs (a background-image dash would not render in game),
   which reads this element's height for the line thickness. background-image: none keeps the
   game's own dashed tracker image from showing behind it. No visibility here: setting it would
   stop the track hiding with the rest of the window on F2. */
.k2-slider #unity-tracker {
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
    height: 1px;
    margin: 0 6px;
    border-width: 0;
    border-radius: 0;
    overflow: visible;
}

.k2-slider #unity-dragger-border {
    padding-right: 8px;
    padding-left: 8px;
}

.k2-slider #unity-dragger {
    height: 20px;
    width: 6px;
    margin-top: -10px;
    background-color: rgb(197, 229, 245);
    border-color: rgb(158, 184, 198);
    border-radius: 4px;
    border-width: 1px;
    transition-property: background-color, border-color;
    transition-duration: 0.2s;
}

.k2-slider #unity-drag-container:active > #unity-dragger {
    background-color: rgb(81, 105, 142);
    border-color: rgb(69, 87, 117);
}

.k2-slider #fill_bar {
    display: none;
}

.k2-slider-main {
    border-color: rgb(63, 66, 154);
    flex-direction: column;
    flex-grow: 1;
}

.k2-slider-main Label {
    font-size: var(--k2-size-label);
}

.k2-slider-main #min_max_bar {
    flex-direction: row;
    justify-content: space-between;
}

.k2-slider-label-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-left: 4px;
    padding-right: 4px;
}

.k2-slider-label-row > Label {
    flex-grow: 0;
    flex-shrink: 1;
    margin: 0;
}

.k2-slider-value-label {
    color: var(--k2-color-value);
}

.k2-slider-main #min_max_bar Label {
    margin-top: -2px;
    font-size: var(--k2-size-small);
    min-width: 0;
}
