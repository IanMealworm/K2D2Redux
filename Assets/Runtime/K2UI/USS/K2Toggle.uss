/* K2UI.K2Toggle: a label with an on/off switch at the far right of its row, following the
   game's own switch (KerbalUI's .unity-toggle.switch) at a smaller size for this narrower panel.
   .long-label shrinks the text for labels that would otherwise push the switch off the row. */

.root {
    --transition-duration-slider-bt: 2s;
}

.slide-toggle__input {
    max-width: 30px;
    border-top-left-radius: 8px;
    border-bottom-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    overflow: visible;
    border-width: 0;
    background-color: rgb(0, 0, 0);
    background-image: url('project://database/Packages/uitkforksp2.controls/Assets/Theme/Sprites/control-frame.png?fileID=21300000&guid=a5c196a2bc627c1469f6f790adb266a8&type=3#control-frame');
    -unity-slice-scale: 0.5px;
    -unity-background-image-tint-color: rgb(73, 77, 91);
    max-height: 18px;
    justify-content: flex-start;
    align-self: auto;
    align-items: flex-start;
    flex-wrap: nowrap;
    margin-top: 7px;
    height: 18px;
    transition-property: background-color;
    transition-duration: 0.2s;
}

.slide-toggle__input-knob {
    height: 15px;
    width: 15px;
    position: absolute;
    border-radius: 5px;
    top: -1px;
    border-width: 1px;
    border-color: rgb(0, 0, 0);
    background-color: rgb(189, 196, 209);
    translate: -1px 0.5px;
    transition-property: translate, background-color;
    transition-duration: 0.2s;
}

.slide-toggle__input:hover > .slide-toggle__input-knob {
    background-color: rgb(160, 174, 201);
}

.slide-toggle__input--checked {
    background-color: rgb(13, 113, 64);
}

.slide-toggle__input--checked > .slide-toggle__input-knob {
    translate: 14px 0.5px;
}

.slide-toggle:focus .slide-toggle__input-knob {
    border-color: rgb(100, 100, 100);
}

.slide-toggle > Label {
    font-size: var(--k2-size-label);
    min-width: 110px;
    color: var(--k2-color-text);
    margin-right: 9px;
}

.slide-toggle {
    align-self: stretch;
    justify-content: space-between;
}

.slide-toggle.long-label > Label {
    font-size: var(--k2-size-info);
    min-width: 90px;
}
