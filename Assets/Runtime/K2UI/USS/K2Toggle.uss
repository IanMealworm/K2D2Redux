.root {
    --transition-duration-slider-bt: 2s;
}

/* Now matches Redux/KerbalUI's own stock ".unity-toggle.switch" recipe (Library/PackageCache/
   uitkforksp2.controls/Assets/Theme/KerbalUI.uss, "Toggle (Switch)" region) - the exact control
   the stock Parts Manager reference panel uses - instead of a from-scratch palette. Reuses
   control-frame.png, the same 9-sliced frame asset Redux ships and tints for its own switch
   track, so no new asset needed. Colors are copied straight from that stock rule set: unchecked
   track tint rgb(73, 77, 91), checked track fill rgb(13, 113, 64) (Redux's own green, not this
   mod's rgb(0, 204, 83) accent - keeping this one control matching the reference exactly rather
   than forcing mod-wide green consistency here), knob rgb(189, 196, 209) in both states (stock
   only moves the knob, it doesn't recolor it). Size/shape (30x18 track, 15x15 knob) stayed at
   this mod's existing proportions rather than stock's larger 54x24 - this panel is narrower than
   Parts Manager's. */
.slide-toggle__input {
    max-width: 30px;
    border-top-left-radius: 8px;
    border-bottom-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    overflow: visible;
    border-width: 0;
    background-color: rgb(0, 0, 0);
    background-image: url('project://database/Packages/uitkforksp2.controls/Assets/Theme/Sprites/control-frame.png?fileID=21300000&guid=a5c196a2bc627c1469f6f790adb266a8&type=3#control-frame');
    -unity-slice-scale: 0.5px;
    -unity-background-image-tint-color: rgb(73, 77, 91);
    max-height: 18px;
    justify-content: flex-start;
    align-self: auto;
    align-items: flex-start;
    flex-wrap: nowrap;
    margin-top: 7px;
    height: 18px;
    transition-property: background-color;
    transition-duration: 0.2s;
}

.slide-toggle__input-knob {
    height: 15px;
    width: 15px;
    position: absolute;
    border-radius: 5px;
    top: -1px;
    border-width: 1px;
    border-color: rgb(0, 0, 0);
    background-color: rgb(189, 196, 209);
    translate: -1px 0.5px;
    transition-property: translate, background-color;
    transition-duration: 0.2s;
}

.slide-toggle__input:hover > .slide-toggle__input-knob {
    background-color: rgb(160, 174, 201);
}

.slide-toggle__input--checked {
    background-color: rgb(13, 113, 64);
}

.slide-toggle__input--checked > .slide-toggle__input-knob {
    translate: 14px 0.5px;
}

.slide-toggle:focus .slide-toggle__input-knob {
    border-color: rgb(100, 100, 100);
}

.slide-toggle > Label {
    font-size: 16px;
    min-width: 110px;
    color: rgb(192, 199, 213);
    margin-right: 9px;
}

/* Pushes the switch itself to the far right of its row instead of sitting right after the label -
   the outer ".slide-toggle" (K2Toggle's root class) had no layout rule at all before this, so it
   was sizing to its children's combined width rather than stretching to fill the row.
   justify-content spreads the label and switch to opposite ends once it does, matching the stock
   Parts Manager reference.

   NOTE: this was "flex-grow: 1" originally, which was the wrong axis - flex-grow controls sizing
   along the PARENT's main axis, and every K2Toggle here sits in a column-flow parent (Turn/Warp/
   Experimental are all plain top-to-bottom VisualElements), so flex-grow:1 was making each toggle
   row grow VERTICALLY to soak up any leftover space in its parent, not stretch horizontally. That
   was invisible as long as the window auto-sized tightly to its content (no leftover space to
   grow into) - it only became visible ("Auto Warp" leaving a large empty gap before "Warp Speed")
   once the AppShell got an explicit height + ScrollView this round, which for the first time gave
   that column real leftover vertical space to hand out. align-self: stretch targets the CROSS
   axis (width, in a column parent) instead, which is what was actually wanted. */
.slide-toggle {
    align-self: stretch;
    justify-content: space-between;
}
