/* K2UI.K2Toggle: a label with an on/off switch at the far right of its row, the same size and
   look as the game's own switch (KerbalUI's .unity-toggle.switch). A label too long for the row
   wraps onto a second line, as the game's switch label does, so the switch is never pushed off.
   .long-label also uses the smaller text. */

.slide-toggle__input {
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: 54px;
    width: 54px;
    height: 24px;
    margin-top: 3px;
    margin-left: 8px;
    border-width: 0;
    border-radius: 10px;
    overflow: visible;
    background-color: rgb(0, 0, 0);
    background-image: url('project://database/Packages/uitkforksp2.controls/Assets/Theme/Sprites/control-frame.png?fileID=21300000&guid=a5c196a2bc627c1469f6f790adb266a8&type=3#control-frame');
    -unity-slice-scale: 0.5px;
    -unity-background-image-tint-color: rgb(73, 77, 91);
    transition-property: background-color;
    transition-duration: 0.2s;
}

.slide-toggle__input-knob {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 26px;
    height: 20px;
    border-width: 1px;
    border-radius: 7px;
    border-color: rgb(0, 0, 0);
    background-color: rgb(189, 196, 209);
    transition-property: left, background-color;
    transition-duration: 0.2s;
}

.slide-toggle__input:hover > .slide-toggle__input-knob {
    background-color: rgb(160, 174, 201);
}

.slide-toggle__input--checked {
    background-color: rgb(13, 113, 64);
}

.slide-toggle__input--checked > .slide-toggle__input-knob {
    left: 26px;
}

.slide-toggle:focus .slide-toggle__input-knob {
    border-color: rgb(100, 100, 100);
}

.slide-toggle > Label {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    white-space: normal;
    font-size: var(--k2-size-label);
    color: var(--k2-color-text);
    -unity-text-align: middle-left;
}

.slide-toggle {
    align-self: stretch;
    justify-content: space-between;
}

.slide-toggle.long-label > Label {
    font-size: var(--k2-size-info);
}
